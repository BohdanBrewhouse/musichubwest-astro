---
/*
  A live flyer beside the "publish your event" form.

  The page promises "vi designar omslaget åt dig" — this shows what that
  means while the form is being filled: the card the event will get in the
  calendar, built from the title, date, place and organiser as they are
  typed. Nothing new is said; empty fields show as blank bars, and the card
  uses the calendar's own event-card grammar (date stamp, badge, title,
  place). Decorative for screen readers: the form itself is the content.
*/
interface Props { lang: 'sv' | 'en' }
const { lang } = Astro.props;
---
<aside class="pub-preview" aria-hidden="true">
  <div class="pub-preview__card">
    <div class="pub-preview__img">
      <svg class="pub-preview__wave" viewBox="0 0 1491 1360" fill="currentColor"><path d="M934.227 49.4527C937.206 20.6073 941.417 1.53254 942.49 0.650253C950.201 -5.69678 1012.57 35.8088 1009.59 64.6544L984.035 589.437C999.31 568.419 1015.74 549.751 1033.41 534.648C1060.44 511.549 1093.83 493.989 1132.39 493.989C1166.5 493.989 1193.89 509.409 1213.09 532.228C1230.72 553.186 1240.9 579.482 1247.33 604.243C1255.68 636.361 1259.66 705.321 1261.41 743.18C1271.7 730.768 1326.82 714.246 1343.5 712.808H1490.5L1449 828.637H1343.5C1338.93 857.081 1335.17 859.132 1326.06 896.83C1319.12 925.511 1310.42 955.7 1299.73 980.069C1294.45 992.107 1287.65 1005.18 1278.74 1016.34C1270.6 1026.54 1254.82 1042.54 1230.16 1046.22C1218.02 1048.04 1205.14 1046.14 1193.470 1039.84C1182.56 1033.96 1175.58 1025.81 1171.35 1019.43C1163.56 1007.68 1160.49 994.884 1158.97 987.024C1155.68 969.959 1154.93 948.392 1154.85 927.482C1154.770 905.689 1155.47 880.331 1156.16 854.306C1156.86 827.938 1157.56 800.408 1157.61 772.947C1157.7 716.806 1154.91 666.102 1145.7 630.664C1141.08 612.896 1135.99 603.714 1132.72 599.826C1132.43 599.48 1132.18 599.213 1131.98 599.009C1126.56 599.129 1116.63 601.667 1101.63 614.484C1086.2 627.676 1068.87 648.919 1050.56 679.006C1014.46 738.335 979.77 823.323 949.439 922.409L893.775 1307.4C883.235 1380.3 776.641 1375.99 772.01 1302.49L721.883 506.822L651.005 828.637C637.322 890.763 549.728 893.443 532.272 832.271L472.196 621.742L388.592 942.092C372.573 1003.47 285.273 1003.02 269.888 941.48L216.671 728.613L207.06 755.848C200.37 774.804 200.5 820.895 156.5 820.895H0L50 741.395L122 712.808L166.068 556.461L166.553 555.13C187.396 499.699 267.377 503.474 282.906 560.622L283.265 561.992L330.229 749.855L411.041 440.215L411.423 438.812C428.117 379.864 512.241 379.374 529.221 438.873L585.712 636.846L686.184 180.677L686.557 179.067C702.897 112.012 801.154 119.584 807.025 188.353L807.146 190.003L849.797 867.016L934.227 49.4527Z"/></svg>
      <span class="badge pub-preview__org" data-pv="organisation"></span>
      <span class="event-card__stamp pub-preview__stamp" hidden>
        <span class="event-card__stamp-d" data-pv="d"></span>
        <span class="event-card__stamp-m"><span data-pv="m"></span><br /><span data-pv="w"></span></span>
      </span>
    </div>
    <div class="pub-preview__body">
      <p class="pub-preview__date" data-pv="date"></p>
      <p class="pub-preview__title" data-pv="eventTitle"></p>
      <p class="pub-preview__place" data-pv="eventLocation"></p>
    </div>
  </div>
</aside>

<script is:inline define:vars={{ lang }}>
(function () {
  var form = document.getElementById('pub-form');
  var box = document.querySelector('.pub-preview');
  if (!form || !box) return;
  var loc = lang === 'en' ? 'en-GB' : 'sv-SE';
  var $ = function (k) { return box.querySelector('[data-pv="' + k + '"]'); };
  var stamp = box.querySelector('.pub-preview__stamp');
  function val(id) { var el = document.getElementById(id); return el ? el.value.trim() : ''; }
  function set(k, v) { var el = $(k); el.textContent = v; el.classList.toggle('is-empty', !v); }
  function draw() {
    set('eventTitle', val('eventTitle'));
    set('eventLocation', val('eventLocation'));
    set('organisation', val('organisation'));
    var d = val('eventDate');
    if (/^\d{4}-\d{2}-\d{2}$/.test(d)) {
      var o = new Date(d + 'T12:00:00');
      var f = function (opt) { return new Intl.DateTimeFormat(loc, opt).format(o).replace('.', ''); };
      set('d', String(o.getDate())); set('m', f({ month: 'short' })); set('w', f({ weekday: 'short' }));
      set('date', f({ day: 'numeric', month: 'long', year: 'numeric' }));
      stamp.hidden = false;
    } else { set('date', ''); stamp.hidden = true; }
  }
  form.addEventListener('input', draw);
  draw();
})();
</script>

<style is:global>
  .pub-live{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:40px;align-items:start}
  .pub-preview{position:sticky;top:96px}
  .pub-preview__card{border:1px solid var(--line);background:var(--black)}
  .pub-preview__img{position:relative;aspect-ratio:4/3;background:var(--lime);color:var(--black);display:grid;place-items:center;overflow:hidden;border-bottom:3px solid var(--line-2)}
  .pub-preview__wave{width:46%;opacity:.9}
  .pub-preview__org{position:absolute;top:12px;left:12px;background:var(--black);color:var(--white);max-width:calc(100% - 24px);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .pub-preview__stamp[hidden]{display:none}
  .pub-preview__body{padding:16px 16px 20px;display:flex;flex-direction:column;gap:8px}
  .pub-preview__date{font-family:var(--font-display);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--lime);margin:0}
  .pub-preview__title{font-family:var(--font-display);font-size:20px;line-height:1.2;margin:0;overflow-wrap:anywhere}
  .pub-preview__place{font-family:var(--font-display);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--text-3);margin:0}
  /* empty fields: blank bars, so the card has its shape before anything is typed */
  .pub-preview .is-empty{display:block;min-height:.9em;background:rgba(255,255,255,.08)}
  .pub-preview__title.is-empty{width:80%;height:22px}
  .pub-preview__date.is-empty{width:45%;height:10px}
  .pub-preview__place.is-empty{width:35%;height:10px}
  .pub-preview__org.is-empty{width:90px;height:20px;background:rgba(13,13,13,.25);border:0}
  @media(max-width:960px){.pub-live{grid-template-columns:minmax(0,1fr)}.pub-preview{display:none}}
  body .pub-form-section__inner:has(.pub-live){max-width:1120px}
</style>
