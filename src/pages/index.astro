---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import EventCard from '../components/EventCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const lang = 'sv';
const events = await getCollection('events', e => e.id.startsWith('sv/'));
// Drop events whose date has passed — they belong in the archive, not the hero/cards
const today = new Date().toISOString().split('T')[0];
const upcoming = events.filter(e => e.data.date >= today);
// Prioritise our own activities (Tune In West category or MHW-organised) so
// they show up first on the hero and the homepage carousel.
const isPriority = (ev: typeof events[number]) =>
  ev.data.category === 'Tune In West' || !ev.data.external_registration_url;
const sorted = upcoming.sort((a, b) => {
  const aPri = isPriority(a) ? 0 : 1;
  const bPri = isPriority(b) ? 0 : 1;
  if (aPri !== bPri) return aPri - bPri;
  return a.data.date.localeCompare(b.data.date);
});
const heroSlides = sorted.slice(0, 5);
const cardEvents = sorted.slice(0, 6);
const articles = await getCollection('articles', a => a.id.startsWith('sv/'));
const latestArticles = articles.sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 3);
---
<Base title="Music Hub West – Start" lang={lang} description="Möt musikbranschen i Västra Götaland. Music Hub West samlar musiker, producenter och kreatörer med events, masterclasses och ett community byggt för dig.">
  <fragment slot="hreflang">
    <link rel="alternate" hreflang="sv" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />
  </fragment>
  <fragment slot="jsonld">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${Astro.site}#website`,
          "url": Astro.site,
          "name": "Music Hub West",
          "inLanguage": "sv-SE",
          "description": "En plattform för musikindustrins tillväxt i Västra Götaland.",
          "potentialAction": {
            "@type": "SearchAction",
            "target": `${Astro.site}evenemang`,
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "Organization",
          "@id": `${Astro.site}#organization`,
          "name": "Music Hub West",
          "url": Astro.site,
          "logo": {
            "@type": "ImageObject",
            "url": new URL('/favicon.svg', Astro.site).toString()
          },
          "sameAs": []
        }
      ]
    })} />
  </fragment>

  <Nav lang={lang} active="start" />

  <section class="hero">
    <div class="hero__slides">
      {heroSlides.map((ev, i) => (
        <div class={`hero__slide ${i === 0 ? 'active' : ''}`} aria-hidden={i === 0 ? 'false' : 'true'}>
          <div class="hero__slide-bg">
            <Image src={ev.data.image} alt="" width={1920} height={1080}
              fetchpriority={i === 0 ? 'high' : undefined}
              loading="eager"
              decoding="async" densities={[1, 2]} />
          </div>
          <div class="hero__slide-content">
            <span class={`badge ${({'Tune In West':'badge--tiw','Kulturverkstaden':'badge--kv','Högskolan för scen och musik':'badge--hsm','VGR':'badge--vgr','Partners':'badge--partner','Externa event':'badge--partner','Kulturakademin':'badge--kulturakademin'} as Record<string,string>)[ev.data.category] ?? ''} hero__badge`}>{(ev.data.category === 'Partners' || ev.data.category === 'Externa event') ? (ev.data.organizer ?? 'Partner') : ev.data.category}</span>
            <h1 class="hero__title" data-text={ev.data.title}>{ev.data.title}</h1>
            <p class="hero__subtitle">{ev.data.date} på {ev.data.location}</p>
            <div class="hero__controls">
              <div class="hero__dots" role="tablist" aria-label="Bildspel">
                {heroSlides.map((_, j) => <button class={`hero__dot ${j === i ? 'active' : ''}`} role="tab" aria-label={`Slide ${j + 1}`} aria-selected={j === i ? 'true' : 'false'}></button>)}
              </div>
              <a href={`/evenemang/${ev.id.replace('sv/', '')}`} class="btn btn--primary">Läs mer</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section__inner">
      <div class="section__head">
        <h2 class="section__title">Kommande event</h2>
        <div class="event-carousel__nav">
          <button class="event-carousel__arrow" id="ev-prev" aria-label="Föregående event" type="button">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="event-carousel__arrow" id="ev-next" aria-label="Nästa event" type="button">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <a href="/evenemang" class="section__link">Se alla →</a>
        </div>
      </div>
      <div class="event-carousel">
        <div class="event-carousel__track" id="ev-track">
          {cardEvents.map((ev, i) => (
            <div class="event-carousel__item">
              <EventCard title={ev.data.title} date={ev.data.date} time={ev.data.time}
                category={ev.data.category} image={ev.data.card_image ?? ev.data.image}
                slug={ev.id.replace('sv/', '')} lang={lang}
                organizer={ev.data.organizer} isOwn={!ev.data.external_registration_url}
                eventType={ev.data.event_type} eventLanguage={ev.data.event_language}
                location={ev.data.location}
                priority={i < 3} />
            </div>
          ))}
          <a href="/evenemang" class="event-carousel__item event-carousel__viewall">
            <span class="event-carousel__viewall-arrow">→</span>
            <span class="event-carousel__viewall-text">Se alla event</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="divider-wave">
    <svg viewBox="0 0 1440 40" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,20 C120,40 240,0 360,20 C480,40 600,0 720,20 C840,40 960,0 1080,20 C1200,40 1320,0 1440,20" stroke="#ccff00" stroke-width="3" fill="none"/>
    </svg>
  </div>

  <section class="section">
    <div class="section__inner">
      <div class="section__head">
        <h2 class="section__title">Nyheter & artiklar</h2>
        <a href="/artiklar" class="section__link">Se alla →</a>
      </div>
      <div class="card-grid">
        {latestArticles.map(a => (
          <ArticleCard
            title={a.data.title}
            author={a.data.author}
            date={a.data.date}
            category={a.data.category}
            description={a.body?.slice(0, 120).replace(/\s+/g, ' ').trim()}
            slug={a.id.replace('sv/', '')}
            lang={lang}
          />
        ))}
      </div>
    </div>
  </section>

  <div class="home-project">
    <div class="home-project__inner">
      <div class="home-project__header">
        <p class="home-project__kicker">Bakom plattformen</p>
        <h2 class="home-project__title">Tune In West</h2>
        <p class="home-project__text">Music Hub West drivs av projektet Tune In West. Ett initiativ som investerar i musikbranschen i Västra Götaland fram till 2029. Nyfiken på mer?</p>
      </div>
      <a href="https://tuneinwest.se" target="_blank" rel="noopener" class="home-project__btn">
        Till projektets webbplats →
      </a>
    </div>
  </div>

  <Footer lang={lang} />
</Base>

<style>
  /* ── Kommande event · horizontal carousel ── */
  .event-carousel__nav {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .event-carousel__arrow {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--black-3);
    background: var(--black-2);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s, opacity 0.15s;
    flex-shrink: 0;
  }
  .event-carousel__arrow:hover {
    background: var(--lime);
    border-color: var(--lime);
    color: var(--black);
  }
  .event-carousel__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .event-carousel__arrow:disabled:hover {
    background: var(--black-2);
    border-color: var(--black-3);
    color: var(--white);
  }

  .event-carousel {
    position: relative;
    margin: 0 -2px;
  }
  .event-carousel__track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 18px 2px 24px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .event-carousel__track::-webkit-scrollbar { display: none; }
  .event-carousel__item {
    flex: 0 0 auto;
    width: 340px;
    max-width: 80vw;
    scroll-snap-align: start;
  }
  .event-carousel__item .event-card { width: 100%; height: 100%; }

  /* "Se alla event" tail card */
  .event-carousel__viewall {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    border: 1px dashed var(--black-3);
    border-radius: 10px;
    background: var(--black-2);
    text-decoration: none;
    color: var(--white);
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
    min-height: 220px;
  }
  .event-carousel__viewall:hover {
    border-color: var(--lime);
    background: rgba(204,255,0,0.04);
    transform: translateY(-2px);
  }
  .event-carousel__viewall-arrow {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--lime);
    color: var(--black);
    font-size: 26px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s;
  }
  .event-carousel__viewall:hover .event-carousel__viewall-arrow { transform: translateX(4px); }
  .event-carousel__viewall-text {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  @media (max-width: 640px) {
    .event-carousel__item { width: 300px; }
  }
</style>

<script>
  const track = document.getElementById('ev-track');
  const prev  = document.getElementById('ev-prev');
  const next  = document.getElementById('ev-next');

  if (track && prev && next) {
    const step = () => {
      const first = track.querySelector('.event-carousel__item');
      const w = first ? first.getBoundingClientRect().width : 340;
      return w + 20; // item width + gap
    };

    const update = () => {
      const maxScroll = track.scrollWidth - track.clientWidth - 1;
      prev.disabled = track.scrollLeft <= 0;
      next.disabled = track.scrollLeft >= maxScroll;
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left:  step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
