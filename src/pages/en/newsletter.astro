---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
const lang = 'en';
---
<Base title="Newsletter · Music Hub West" lang={lang}
  description="Subscribe to the Music Hub West newsletter — events, open calls and news from the music scene in Western Sweden, roughly once a month.">
  <Nav lang={lang} active="" />

  <main>
    {/* Confirmation states — filled in client-side from ?status=, since the page is static */}
    <div class="nl-status" id="nlStatus" hidden>
      <div class="nl-status__inner">
        <p class="nl-status__icon" id="nlStatusIcon"></p>
        <h1 class="nl-status__title" id="nlStatusTitle"></h1>
        <p class="nl-status__text" id="nlStatusText"></p>
        <a href="/en/events" class="btn btn--primary">See all events →</a>
      </div>
    </div>

    <NewsletterForm lang={lang} variant="band" />
  </main>

  <Footer lang={lang} newsletter={false} />
</Base>

<script is:inline>
  const STATES = {
    unsubscribed: {
      icon: '—',
      title: 'You’re unsubscribed',
      text: 'We won’t include you in the newsletter any more. If you change your mind you’re very welcome back — sign up again below.',
    },
    invalid: {
      icon: '✕',
      title: 'That link didn’t work',
      text: 'The link seems to have broken on the way — some email clients cut long addresses. Email us at hello@musichubwest.se and we’ll remove you manually.',
    },
    error: {
      icon: '✕',
      title: 'Something went wrong',
      text: 'We couldn’t process your request right now. Try again, or email us at hello@musichubwest.se.',
    },
  };

  const status = new URLSearchParams(location.search).get('status');
  const state = STATES[status];
  if (state) {
    document.getElementById('nlStatusIcon').textContent  = state.icon;
    document.getElementById('nlStatusTitle').textContent = state.title;
    document.getElementById('nlStatusText').textContent  = state.text;
    const box = document.getElementById('nlStatus');
    box.hidden = false;
    box.classList.add(status === 'unsubscribed' ? 'nl-status--ok' : 'nl-status--err');
  }
</script>
