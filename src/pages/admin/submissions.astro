---
// Admin dashboard for event submissions — standalone app-style page.
// All data is fetched client-side through /api/admin, gated by ADMIN_PASSWORD.
// noindex + robots Disallow keep it out of search.
---
<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Eventansökningar · Admin · Music Hub West</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Syne+Mono&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --bg: #070707;
      --bg-2: #0e0e0e;
      --bg-3: #161616;
      --line: rgba(255,255,255,0.08);
      --line-2: rgba(255,255,255,0.14);
      --lime: #CCFF00;
      --lime-dim: rgba(204,255,0,0.12);
      --white: #fff;
      --mut: rgba(255,255,255,0.55);
      --mut-2: rgba(255,255,255,0.35);
      --amber: #F5C518;
      --green: #3FB950;
      --blue: #388BFD;
      --red: #F85149;
      --mono: 'Syne Mono', 'Courier New', monospace;
      --sans: 'Outfit', -apple-system, 'Helvetica Neue', Arial, sans-serif;
    }
    * { box-sizing: border-box; }
    html { color-scheme: dark; }
    body {
      margin: 0; background: var(--bg); color: var(--white);
      font-family: var(--sans); -webkit-font-smoothing: antialiased;
      background-image:
        radial-gradient(1200px 500px at 80% -10%, rgba(204,255,0,0.05), transparent 60%),
        radial-gradient(900px 400px at -10% 0%, rgba(204,255,0,0.03), transparent 50%);
      background-attachment: fixed;
    }

    /* ───────────────────────── LOGIN ───────────────────────── */
    .login { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }
    .login__box {
      width: 100%; max-width: 400px;
      background: linear-gradient(180deg, var(--bg-2), var(--bg));
      border: 1px solid var(--line); border-radius: 20px; padding: 40px 36px;
      box-shadow: 0 24px 80px rgba(0,0,0,0.6);
    }
    .login__mark {
      font-family: var(--mono); font-size: 13px; letter-spacing: .22em;
      color: var(--lime); text-transform: uppercase; margin: 0 0 10px;
    }
    .login__title { font-family: var(--mono); font-size: 30px; font-weight: 400; margin: 0 0 4px; line-height: 1.1; }
    .login__sub { font-size: 14px; color: var(--mut); margin: 0 0 28px; }
    .login__err { color: var(--red); font-size: 13px; margin-top: 12px; min-height: 18px; }

    /* ───────────────────────── INPUTS / BUTTONS ───────────────────────── */
    .in {
      width: 100%; background: var(--bg); color: var(--white);
      border: 1px solid var(--line-2); border-radius: 10px; padding: 12px 14px;
      font-size: 14px; font-family: inherit; outline: none;
      transition: border-color .15s, box-shadow .15s;
    }
    .in:focus { border-color: var(--lime); box-shadow: 0 0 0 3px var(--lime-dim); }
    .in::placeholder { color: var(--mut-2); }
    select.in { cursor: pointer; appearance: none; padding-right: 34px;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path d='M1 1l4 4 4-4' stroke='%23999' stroke-width='1.6' fill='none' stroke-linecap='round'/></svg>");
      background-repeat: no-repeat; background-position: right 13px center; }
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      background: var(--lime); color: #050505; border: none; border-radius: 10px;
      padding: 11px 20px; font-weight: 700; font-size: 14px; cursor: pointer;
      font-family: inherit; transition: transform .12s, opacity .15s; white-space: nowrap;
    }
    .btn:hover { opacity: .9; transform: translateY(-1px); }
    .btn:disabled { opacity: .45; cursor: default; transform: none; }
    .btn--ghost { background: transparent; color: var(--mut); border: 1px solid var(--line-2); }
    .btn--ghost:hover { color: var(--white); border-color: var(--mut); opacity: 1; }
    .btn--danger { background: transparent; color: var(--red); border: 1px solid rgba(248,81,73,0.35); }
    .btn--danger:hover { background: rgba(248,81,73,0.1); opacity: 1; }
    .btn--sm { padding: 8px 14px; font-size: 13px; border-radius: 8px; }

    /* ───────────────────────── APP SHELL ───────────────────────── */
    .shell { max-width: 1180px; margin: 0 auto; padding: 0 24px 100px; }

    .topbar {
      position: sticky; top: 0; z-index: 50;
      display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
      padding: 18px 0 16px; margin-bottom: 28px;
      background: linear-gradient(180deg, rgba(7,7,7,0.96) 70%, rgba(7,7,7,0));
      backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    }
    .brand { display: flex; align-items: center; gap: 14px; }
    .brand__mark {
      width: 42px; height: 42px; border-radius: 11px; background: var(--lime);
      color: #050505; font-family: var(--mono); font-size: 13px; font-weight: 700;
      display: flex; align-items: center; justify-content: center; letter-spacing: -0.04em;
      box-shadow: 0 0 24px rgba(204,255,0,0.25);
    }
    .brand__title { font-family: var(--mono); font-size: 19px; margin: 0; line-height: 1.1; font-weight: 400; }
    .brand__sub { font-size: 11.5px; color: var(--mut); margin: 2px 0 0; letter-spacing: .04em; }
    .topbar__search { flex: 1; min-width: 220px; max-width: 420px; margin-left: auto; }

    /* ───────────────────────── STAT TILES ───────────────────────── */
    .stats { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; margin-bottom: 22px; }
    .stat {
      background: var(--bg-2); border: 1px solid var(--line); border-radius: 14px;
      padding: 14px 16px 12px; cursor: pointer; text-align: left; font-family: inherit;
      transition: border-color .15s, background .15s, transform .12s; color: inherit; position: relative; overflow: hidden;
    }
    .stat:hover { border-color: var(--line-2); transform: translateY(-1px); }
    .stat__num { font-family: var(--mono); font-size: 26px; line-height: 1; display: block; margin-bottom: 6px; }
    .stat__label { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--mut); }
    .stat::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: transparent; }
    .stat[data-k="new"] .stat__num        { color: var(--lime); }
    .stat[data-k="reviewing"] .stat__num  { color: var(--amber); }
    .stat[data-k="approved"] .stat__num   { color: var(--green); }
    .stat[data-k="published"] .stat__num  { color: var(--blue); }
    .stat[data-k="rejected"] .stat__num   { color: var(--red); }
    .stat.active { background: var(--bg-3); border-color: var(--line-2); }
    .stat.active::after { background: var(--lime); }
    .stat[data-k="new"].active::after        { background: var(--lime); }
    .stat[data-k="reviewing"].active::after  { background: var(--amber); }
    .stat[data-k="approved"].active::after   { background: var(--green); }
    .stat[data-k="published"].active::after  { background: var(--blue); }
    .stat[data-k="rejected"].active::after   { background: var(--red); }

    /* ───────────────────────── TOOLBAR ───────────────────────── */
    .toolbar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 20px; }
    .toolbar__label { font-size: 12px; color: var(--mut); letter-spacing: .04em; }
    .seg { display: inline-flex; background: var(--bg-2); border: 1px solid var(--line); border-radius: 10px; padding: 3px; gap: 2px; }
    .seg__btn {
      background: transparent; border: none; color: var(--mut); font-family: inherit;
      font-size: 12.5px; font-weight: 600; padding: 7px 14px; border-radius: 8px; cursor: pointer;
      transition: all .15s;
    }
    .seg__btn:hover { color: var(--white); }
    .seg__btn.active { background: var(--lime); color: #050505; }
    .toolbar__right { margin-left: auto; font-size: 12px; color: var(--mut-2); }

    /* ───────────────────────── CARDS ───────────────────────── */
    .list { display: flex; flex-direction: column; gap: 14px; }
    .card {
      background: var(--bg-2); border: 1px solid var(--line); border-radius: 16px;
      overflow: hidden; position: relative; transition: border-color .15s;
    }
    .card::before {
      content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
      background: var(--mut-2);
    }
    .card[data-status="new"]::before       { background: var(--lime); box-shadow: 0 0 12px rgba(204,255,0,0.4); }
    .card[data-status="reviewing"]::before { background: var(--amber); }
    .card[data-status="approved"]::before  { background: var(--green); }
    .card[data-status="published"]::before { background: var(--blue); }
    .card[data-status="rejected"]::before  { background: var(--red); }
    .card:hover { border-color: var(--line-2); }
    .card--overdue { opacity: .65; }

    .card__head {
      display: flex; align-items: flex-start; justify-content: space-between; gap: 16px;
      padding: 18px 22px 16px; cursor: pointer; user-select: none;
    }
    .card__title-wrap { min-width: 0; }
    .card__title { font-size: 17px; font-weight: 700; margin: 0 0 3px; display: flex; align-items: center; gap: 8px; }
    .card__chev { color: var(--mut-2); font-size: 11px; transition: transform .2s; flex-shrink: 0; }
    .card.collapsed .card__chev { transform: rotate(-90deg); }
    .card__who { font-size: 13px; color: var(--mut); }
    .card__side { text-align: right; flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: 5px; }
    .card__dates { font-size: 11.5px; color: var(--mut-2); line-height: 1.5; }

    .badge {
      display: inline-block; font-family: var(--mono); font-size: 10px; letter-spacing: .08em;
      text-transform: uppercase; padding: 4px 10px; border-radius: 6px; line-height: 1.3;
    }
    .badge--new       { background: var(--lime); color: #050505; }
    .badge--reviewing { background: rgba(245,197,24,0.16); color: var(--amber); border: 1px solid rgba(245,197,24,0.35); }
    .badge--approved  { background: rgba(63,185,80,0.16); color: var(--green); border: 1px solid rgba(63,185,80,0.35); }
    .badge--published { background: rgba(56,139,253,0.16); color: var(--blue); border: 1px solid rgba(56,139,253,0.35); }
    .badge--rejected  { background: rgba(248,81,73,0.16); color: var(--red); border: 1px solid rgba(248,81,73,0.35); }

    .pill { display: inline-block; font-size: 10.5px; font-weight: 700; padding: 3px 9px; border-radius: 999px; }
    .pill--soon { background: rgba(245,197,24,0.14); color: var(--amber); }
    .pill--ok   { background: rgba(255,255,255,0.07); color: var(--mut); }
    .pill--over { background: rgba(248,81,73,0.14); color: var(--red); }
    .pill--en   { background: rgba(56,139,253,0.14); color: var(--blue); }

    .card__body { padding: 4px 22px 20px; }
    .card.collapsed .card__body, .card.collapsed .card__foot, .card.collapsed .mail { display: none; }

    .meta {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 14px 22px; padding: 14px 0 16px; border-top: 1px solid var(--line);
    }
    .meta__item { min-width: 0; }
    .meta__label { display: block; font-size: 10px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--mut-2); margin-bottom: 3px; }
    .meta__value { font-size: 14px; color: #e8e8e8; word-break: break-word; }
    .meta__value a { color: var(--lime); text-decoration: none; }
    .meta__value a:hover { text-decoration: underline; }

    .desc {
      white-space: pre-wrap; background: var(--bg); border: 1px solid var(--line);
      border-radius: 10px; padding: 14px 16px; color: #ddd; font-size: 14px;
      line-height: 1.65; max-height: 230px; overflow: auto; margin-bottom: 16px;
    }

    .sec-label { font-size: 10px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--mut-2); margin: 0 0 8px; }
    .files { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; }
    .thumb {
      display: block; width: 92px; height: 92px; border-radius: 10px; overflow: hidden;
      border: 1px solid var(--line-2); background: var(--bg); transition: border-color .15s, transform .12s;
    }
    .thumb:hover { border-color: var(--lime); transform: translateY(-2px); }
    .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .filechip {
      display: inline-flex; align-items: center; gap: 6px; background: var(--bg);
      border: 1px solid var(--line-2); border-radius: 8px; padding: 8px 12px;
      font-size: 12.5px; color: var(--lime); text-decoration: none;
    }
    .filechip:hover { border-color: var(--lime); }

    .notes { display: flex; flex-direction: column; gap: 8px; }
    .notes textarea { min-height: 56px; resize: vertical; font-size: 13.5px; line-height: 1.5; }
    .notes__row { display: flex; align-items: center; gap: 10px; }
    .saved { font-size: 12px; color: var(--green); opacity: 0; transition: opacity .2s; }
    .saved.show { opacity: 1; }

    .card__foot {
      display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
      padding: 14px 22px; border-top: 1px solid var(--line); background: rgba(0,0,0,0.25);
    }
    .card__foot .sec-label { margin: 0; }
    .spacer { flex: 1; }

    /* ───────────────────────── EMAIL COMPOSER ───────────────────────── */
    .mail { display: none; border-top: 1px solid var(--line); background: rgba(204,255,0,0.025); padding: 20px 22px 22px; }
    .mail.open { display: block; }
    .mail__head { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
    .mail__title { font-family: var(--mono); font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--lime); }
    .mail__tpls { display: flex; gap: 8px; flex-wrap: wrap; margin-left: auto; }
    .tpl {
      background: var(--bg-2); border: 1px solid var(--line-2); color: var(--mut);
      border-radius: 999px; padding: 6px 13px; font-size: 12px; cursor: pointer; font-family: inherit;
      transition: all .15s;
    }
    .tpl:hover { color: var(--lime); border-color: var(--lime); }
    .mail__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
    .mail label { font-size: 10px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--mut-2); display: block; margin-bottom: 5px; }
    .mail textarea { min-height: 170px; resize: vertical; line-height: 1.55; font-size: 14px; }
    .mail__send { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; margin-top: 14px; }
    .mode { display: inline-flex; background: var(--bg-2); border: 1px solid var(--line); border-radius: 10px; padding: 3px; gap: 2px; }
    .mode label {
      margin: 0; text-transform: none; letter-spacing: 0; font-weight: 600; font-size: 12.5px;
      color: var(--mut); cursor: pointer; padding: 7px 14px; border-radius: 8px; transition: all .15s;
    }
    .mode input { display: none; }
    .mode label:has(input:checked) { background: var(--lime); color: #050505; }
    .when { display: none; width: auto; }
    .when.show { display: inline-block; }
    .hint { font-size: 12.5px; }
    .hint.ok { color: var(--green); }
    .hint.err { color: var(--red); }

    /* ───────────────────────── EMPTY / LOADING ───────────────────────── */
    .empty { text-align: center; color: var(--mut); padding: 70px 0; }
    .empty__icon { font-size: 28px; margin-bottom: 10px; opacity: .5; }
    .loading { display: flex; align-items: center; justify-content: center; gap: 12px; color: var(--mut); padding: 70px 0; font-size: 14px; }
    .spin {
      width: 18px; height: 18px; border-radius: 50%;
      border: 2px solid var(--line-2); border-top-color: var(--lime);
      animation: spin .8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ───────────────────────── EMAIL HISTORY ───────────────────────── */
    .hist__item { border: 1px solid var(--line); border-radius: 9px; margin-bottom: 8px; background: var(--bg); overflow: hidden; }
    .hist__item summary { list-style: none; display: flex; align-items: center; gap: 9px; padding: 10px 13px; cursor: pointer; font-size: 13px; flex-wrap: wrap; }
    .hist__item summary::-webkit-details-marker { display: none; }
    .hist__item summary:hover { background: rgba(255,255,255,0.03); }
    .hist__dir { font-family: var(--mono); color: var(--lime); flex-shrink: 0; }
    .hist__dir--in { color: var(--blue); }
    .hist__subj { font-weight: 600; color: #e8e8e8; }
    .hist__date { margin-left: auto; font-size: 11.5px; color: var(--mut-2); }
    .hist__body { padding: 10px 13px 13px; font-size: 13px; color: var(--mut); white-space: pre-wrap; line-height: 1.6; border-top: 1px solid var(--line); }

    /* ───────────────────────── COPY CHIP ───────────────────────── */
    .copy { background: none; border: none; color: var(--mut-2); cursor: pointer; font-size: 13px; padding: 2px 7px; border-radius: 5px; font-family: inherit; vertical-align: middle; }
    .copy:hover { color: var(--lime); background: var(--lime-dim); }

    /* ───────────────────────── LIGHTBOX ───────────────────────── */
    .lb {
      position: fixed; inset: 0; z-index: 200; display: none;
      flex-direction: column; align-items: center; justify-content: center;
      background: rgba(4,4,4,0.93);
      backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
      padding: 70px 16px 28px;
    }
    .lb.open { display: flex; }
    .lb__bar {
      position: absolute; top: 0; left: 0; right: 0;
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 14px 18px;
    }
    .lb__count { font-family: var(--mono); font-size: 13px; color: var(--mut); letter-spacing: .08em; }
    .lb__actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
    .lb__close {
      background: var(--bg-3); border: 1px solid var(--line-2); color: var(--white);
      width: 38px; height: 38px; border-radius: 50%; font-size: 15px; cursor: pointer; transition: all .15s;
    }
    .lb__close:hover { background: var(--lime); color: #050505; border-color: var(--lime); }
    .lb__img {
      max-width: min(92vw, 1100px); max-height: 74vh; object-fit: contain;
      border-radius: 10px; box-shadow: 0 30px 80px rgba(0,0,0,0.65); user-select: none;
    }
    .lb__nav {
      position: absolute; top: 50%; transform: translateY(-50%);
      width: 46px; height: 46px; border-radius: 50%;
      background: var(--bg-3); border: 1px solid var(--line-2); color: var(--white);
      font-size: 24px; line-height: 1; cursor: pointer; transition: all .15s;
      display: flex; align-items: center; justify-content: center; padding: 0 0 3px;
    }
    .lb__nav:hover { background: var(--lime); color: #050505; border-color: var(--lime); }
    .lb__nav:disabled { opacity: .25; pointer-events: none; }
    .lb__nav--prev { left: 18px; }
    .lb__nav--next { right: 18px; }

    /* ───────────────────────── RESPONSIVE ───────────────────────── */
    @media (max-width: 900px) { .stats { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 640px) {
      .shell { padding: 0 14px 80px; }
      .topbar { padding: 12px 0; gap: 10px; margin-bottom: 18px; }
      .brand__mark { width: 36px; height: 36px; border-radius: 9px; font-size: 11px; }
      .brand__title { font-size: 16px; }
      .brand__sub { font-size: 10.5px; }
      .topbar__search { order: 3; flex-basis: 100%; max-width: none; margin-left: 0; }
      .stats { grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 16px; }
      .stat { padding: 10px 12px 9px; border-radius: 11px; }
      .stat__num { font-size: 20px; margin-bottom: 4px; }
      .stat__label { font-size: 9.5px; letter-spacing: .06em; }
      .toolbar { gap: 8px; margin-bottom: 16px; }
      .list { gap: 12px; }
      .card__head { flex-direction: column; gap: 10px; padding: 15px 16px 12px; }
      .card__side { align-items: flex-start; text-align: left; }
      .card__body { padding: 0 16px 16px; }
      .card__foot { padding: 12px 16px; gap: 8px; }
      .card__foot select.in { flex: 1; }
      .mail { padding: 16px 16px 18px; }
      .mail__grid { grid-template-columns: 1fr; }
      .mail__head { flex-wrap: wrap; }
      .mail__tpls { margin-left: 0; }
      .mail__send { flex-direction: column; align-items: stretch; }
      .mode { width: 100%; display: flex; }
      .mode label { flex: 1; text-align: center; }
      .when.show { width: 100%; }
      .thumb { width: 80px; height: 80px; }
      /* lightbox: arrows move to bottom, easier thumb reach */
      .lb { padding: 80px 10px 96px; }
      .lb__img { max-height: 62vh; }
      .lb__nav { top: auto; bottom: 26px; transform: none; }
      .lb__nav--prev { left: calc(50% - 62px); }
      .lb__nav--next { right: calc(50% - 62px); }
    }
  </style>
</head>
<body>
  <!-- LOGIN -->
  <div class="login" id="login">
    <div class="login__box">
      <p class="login__mark">Music Hub West</p>
      <h1 class="login__title">Admin</h1>
      <p class="login__sub">Eventansökningar</p>
      <form id="login-form">
        <input class="in" type="password" id="pw" placeholder="Lösenord" autocomplete="current-password" />
        <div class="login__err" id="login-err"></div>
        <button class="btn" type="submit" id="login-btn" style="width:100%;margin-top:6px;">Logga in →</button>
      </form>
    </div>
  </div>

  <!-- APP -->
  <div class="shell" id="app" hidden>
    <div class="topbar">
      <div class="brand">
        <div class="brand__mark">MHW</div>
        <div>
          <h1 class="brand__title">Eventansökningar</h1>
          <p class="brand__sub">Admin · Music Hub West</p>
        </div>
      </div>
      <input class="in topbar__search" type="search" id="search" placeholder="Sök namn, organisation, titel…" />
      <button class="btn btn--ghost btn--sm" id="refresh" title="Uppdatera listan">↻</button>
      <button class="btn btn--ghost btn--sm" id="logout">Logga ut</button>
    </div>

    <div class="stats" id="stats"></div>

    <div class="toolbar">
      <span class="toolbar__label">Sortera</span>
      <div class="seg">
        <button class="seg__btn active" data-sort="submitted">Senast inskickad</button>
        <button class="seg__btn" data-sort="event">Eventdatum</button>
      </div>
      <span class="toolbar__right" id="result-count"></span>
    </div>

    <div class="list" id="list"></div>
    <div class="empty" id="empty" hidden>
      <div class="empty__icon">📭</div>
      Inga ansökningar matchar.
    </div>
  </div>

  <!-- LIGHTBOX -->
  <div class="lb" id="lb" aria-hidden="true">
    <div class="lb__bar">
      <span class="lb__count" id="lb-count"></span>
      <div class="lb__actions">
        <button class="btn btn--ghost btn--sm" id="lb-dl">↓ Ladda ner</button>
        <button class="btn btn--ghost btn--sm" id="lb-dl-all">⇩ Alla (.zip)</button>
        <button class="lb__close" id="lb-close" aria-label="Stäng">✕</button>
      </div>
    </div>
    <button class="lb__nav lb__nav--prev" id="lb-prev" aria-label="Föregående">‹</button>
    <img class="lb__img" id="lb-img" alt="" />
    <button class="lb__nav lb__nav--next" id="lb-next" aria-label="Nästa">›</button>
  </div>

  <script is:inline>
  (function () {
    const STATUSES = [
      { key: 'new',        label: 'Nya' },
      { key: 'reviewing',  label: 'Granskas' },
      { key: 'approved',   label: 'Godkända' },
      { key: 'published',  label: 'Publicerade' },
      { key: 'rejected',   label: 'Avvisade' },
    ];
    const STATUS_LABEL = Object.fromEntries(STATUSES.map(s => [s.key, s.label]));
    const PUBLISH_LABEL = { 'site': 'Bara på sajten', 'site-and-social': 'Sajten + sociala kanaler' };
    const IMG_RE = /\.(jpe?g|png|webp|gif|avif)(\?|$)/i;

    const loginView = document.getElementById('login');
    const appView   = document.getElementById('app');
    const loginForm = document.getElementById('login-form');
    const pwInput   = document.getElementById('pw');
    const loginBtn  = document.getElementById('login-btn');
    const loginErr  = document.getElementById('login-err');
    const statsEl   = document.getElementById('stats');
    const listEl    = document.getElementById('list');
    const emptyEl   = document.getElementById('empty');
    const searchEl  = document.getElementById('search');
    const countEl   = document.getElementById('result-count');

    let password = sessionStorage.getItem('mhw-admin-pw') || '';
    let all = [];
    let msgs = {}; // email history grouped by submission_id
    let activeTab = 'all';
    let sortBy = 'submitted';

    function esc(s) {
      return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }
    function fmtDate(d) {
      if (!d) return '';
      try { return new Intl.DateTimeFormat('sv-SE', { day:'numeric', month:'short', year:'numeric' }).format(new Date(d)); }
      catch { return d; }
    }
    function fmtDateTime(d) {
      if (!d) return '';
      try { return new Intl.DateTimeFormat('sv-SE', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' }).format(new Date(d)); }
      catch { return d; }
    }
    function daysUntil(dateStr) {
      if (!dateStr) return null;
      const today = new Date(); today.setHours(0,0,0,0);
      const d = new Date(dateStr); d.setHours(0,0,0,0);
      if (isNaN(d)) return null;
      return Math.round((d - today) / 86400000);
    }
    function daysLeftPill(dateStr) {
      const n = daysUntil(dateStr);
      if (n === null) return '';
      if (n < 0)   return `<span class="pill pill--over">Passerat</span>`;
      if (n === 0) return `<span class="pill pill--soon">Idag</span>`;
      if (n <= 21) return `<span class="pill pill--soon">${n} dagar kvar</span>`;
      return `<span class="pill pill--ok">${n} dagar kvar</span>`;
    }

    async function api(action, extra) {
      const res = await fetch('/api/admin', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password, action, ...extra }),
      });
      if (res.status === 401) throw new Error('unauthorized');
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json.ok) throw new Error(json.error || 'error');
      return json;
    }

    async function loadList() {
      listEl.innerHTML = '<div class="loading"><span class="spin"></span> Laddar ansökningar…</div>';
      const json = await api('list');
      all = json.submissions || [];
      msgs = {};
      (json.messages || []).forEach(m => {
        if (!m.submission_id) return;
        (msgs[m.submission_id] = msgs[m.submission_id] || []).push(m);
      });
      renderStats();
      render();
    }

    function counts() {
      const c = { all: all.length };
      for (const s of STATUSES) c[s.key] = all.filter(x => (x.status || 'new') === s.key).length;
      return c;
    }

    function renderStats() {
      const c = counts();
      const tiles = [{ key: 'all', label: 'Alla' }, ...STATUSES];
      statsEl.innerHTML = tiles.map(t =>
        `<button class="stat${t.key === activeTab ? ' active' : ''}" data-k="${t.key}">
          <span class="stat__num">${c[t.key] ?? 0}</span>
          <span class="stat__label">${t.label}</span>
        </button>`
      ).join('');
      statsEl.querySelectorAll('.stat').forEach(b => b.addEventListener('click', () => {
        activeTab = b.dataset.k; renderStats(); render();
      }));
    }

    function render() {
      const q = (searchEl.value || '').toLowerCase().trim();
      let rows = all;
      if (activeTab !== 'all') rows = rows.filter(r => (r.status || 'new') === activeTab);
      if (q) rows = rows.filter(r =>
        [r.first_name, r.last_name, r.organisation, r.event_title, r.email].join(' ').toLowerCase().includes(q)
      );
      if (sortBy === 'event') rows = [...rows].sort((a, b) => (a.event_date || '').localeCompare(b.event_date || ''));
      else rows = [...rows].sort((a, b) => (b.created_at || '').localeCompare(a.created_at || ''));

      countEl.textContent = rows.length ? `${rows.length} ansökningar` : '';
      emptyEl.hidden = rows.length > 0;
      listEl.innerHTML = rows.map(cardHtml).join('');
      wireCards();
    }

    function mailTemplate(kind, r) {
      const name = r.first_name || 'där';
      const title = r.event_title || 'ditt event';
      if (kind === 'approved') return {
        subject: `Ditt event är godkänt – Music Hub West`,
        body: `Hej ${name},\n\nVad roligt — vi har granskat din ansökan för "${title}" och kommer att publicera den på Music Hub West!\n\nVi designar ett omslag som matchar vår profil och hör av oss om vi behöver något mer från dig.\n\nVänliga hälsningar,\nMusic Hub West`,
      };
      if (kind === 'rejected') return {
        subject: `Angående din eventansökan – Music Hub West`,
        body: `Hej ${name},\n\nTack för att du skickade in "${title}". Tyvärr kan vi inte publicera just detta event den här gången.\n\nDen här tjänsten är till för aktörer inom musikbranschen i Västra Götaland, och vi hoppas få se fler ansökningar från dig framöver.\n\nVänliga hälsningar,\nMusic Hub West`,
      };
      return {
        subject: `Angående din eventansökan – Music Hub West`,
        body: `Hej ${name},\n\nTack för din ansökan för "${title}". Vi behöver lite mer information innan vi kan gå vidare:\n\n- \n\nHör av dig så hjälps vi åt!\n\nVänliga hälsningar,\nMusic Hub West`,
      };
    }

    function histItems(subId) {
      const list = msgs[subId] || [];
      if (!list.length) return '<span style="font-size:13px;color:var(--mut-2)">Inga mejl skickade ännu.</span>';
      return list.map(m => {
        const sched = m.scheduled_at && new Date(m.scheduled_at) > new Date();
        return `<details class="hist__item">
          <summary>
            <span class="hist__dir${m.direction === 'in' ? ' hist__dir--in' : ''}">${m.direction === 'in' ? '←' : '→'}</span>
            <span class="hist__subj">${esc(m.subject || '(inget ämne)')}</span>
            ${sched ? `<span class="pill pill--soon">Schemalagt ${fmtDateTime(m.scheduled_at)}</span>` : ''}
            <span class="hist__date">${fmtDateTime(m.created_at)}</span>
          </summary>
          <div class="hist__body">${esc(m.body || '')}</div>
        </details>`;
      }).join('');
    }

    function cardHtml(r) {
      const st = r.status || 'new';
      const urls = r.file_urls || [];
      let imgI = 0;
      const files = urls.map((u, i) =>
        IMG_RE.test(u)
          ? `<a class="thumb" href="${esc(u)}" data-lb="${imgI++}" title="Fil ${i+1}"><img src="${esc(u)}" alt="Fil ${i+1}" loading="lazy"></a>`
          : `<a class="filechip" href="${esc(u)}" target="_blank" rel="noopener">📎 Fil ${i+1}</a>`
      ).join('');
      const publishLabel = r.publish_type ? (PUBLISH_LABEL[r.publish_type] || r.publish_type) : '';
      const opts = STATUSES.map(s => `<option value="${s.key}"${s.key===st?' selected':''}>${s.label}</option>`).join('');
      const overdue = (daysUntil(r.event_date) ?? 1) < 0;
      return `
      <div class="card${overdue ? ' card--overdue' : ''}" data-id="${r.id}" data-status="${st}">
        <div class="card__head">
          <div class="card__title-wrap">
            <h2 class="card__title">${esc(r.event_title)} <span class="card__chev">▼</span></h2>
            <div class="card__who">${esc(r.first_name)} ${esc(r.last_name)} · ${esc(r.organisation)}</div>
          </div>
          <div class="card__side">
            <span class="badge badge--${st}">${esc(STATUS_LABEL[st] || st)}</span>
            <div>${daysLeftPill(r.event_date)} ${urls.length ? `<span class="pill pill--ok">📎 ${urls.length}</span>` : ''} ${r.lang === 'en' ? '<span class="pill pill--en">EN</span>' : ''}</div>
            <div class="card__dates">${fmtDate(r.event_date)} · ${esc(r.event_location)}<br>Inskickad ${fmtDateTime(r.created_at)}</div>
          </div>
        </div>

        <div class="card__body">
          <div class="meta">
            <div class="meta__item"><span class="meta__label">E-post</span><span class="meta__value"><a href="mailto:${esc(r.email)}">${esc(r.email)}</a> <button class="copy" data-copy="${esc(r.email)}" title="Kopiera e-post">⧉</button></span></div>
            <div class="meta__item"><span class="meta__label">Telefon</span><span class="meta__value">${esc(r.phone) || '—'}</span></div>
            <div class="meta__item"><span class="meta__label">Datum</span><span class="meta__value">${fmtDate(r.event_date)}</span></div>
            <div class="meta__item"><span class="meta__label">Plats</span><span class="meta__value">${esc(r.event_location)}</span></div>
            ${publishLabel ? `<div class="meta__item"><span class="meta__label">Publicering</span><span class="meta__value">${esc(publishLabel)}</span></div>` : ''}
            ${r.registration_url ? `<div class="meta__item"><span class="meta__label">Anmälningslänk</span><span class="meta__value"><a href="${esc(r.registration_url)}" target="_blank" rel="noopener">${esc(r.registration_url)}</a></span></div>` : ''}
          </div>

          <p class="sec-label">Beskrivning</p>
          <div class="desc">${esc(r.description)}</div>

          <p class="sec-label">Filer</p>
          <div class="files">${files || '<span style="font-size:13px;color:var(--mut-2)">Inga filer</span>'}</div>

          <div class="notes">
            <p class="sec-label" style="margin:0">Interna anteckningar</p>
            <textarea class="in" data-notes placeholder="Anteckningar för teamet…">${esc(r.internal_notes || '')}</textarea>
            <div class="notes__row">
              <button class="btn btn--ghost btn--sm" data-save-notes>Spara anteckning</button>
              <span class="saved" data-hint>Sparat ✓</span>
            </div>
          </div>

          <p class="sec-label" style="margin:16px 0 8px">Mejlhistorik</p>
          <div data-hist>${histItems(r.id)}</div>
        </div>

        <div class="card__foot">
          <span class="sec-label">Status</span>
          <select class="in" data-status style="width:auto">${opts}</select>
          <button class="btn btn--ghost btn--sm" data-mail-toggle>✉ Mejla sökanden</button>
          <div class="spacer"></div>
          <button class="btn btn--danger btn--sm" data-delete>Ta bort</button>
        </div>

        <div class="mail" data-mail>
          <div class="mail__head">
            <span class="mail__title">✉ Mejl till sökanden</span>
            <div class="mail__tpls">
              <button class="tpl" data-tpl="approved">Godkänd-mall</button>
              <button class="tpl" data-tpl="rejected">Avvisad-mall</button>
              <button class="tpl" data-tpl="info">Begär info</button>
            </div>
          </div>
          <div class="mail__grid">
            <div><label>Till</label><input class="in" type="email" data-mail-to value="${esc(r.email)}" /></div>
            <div><label>Ämne</label><input class="in" type="text" data-mail-subject placeholder="Ämne…" /></div>
          </div>
          <label>Meddelande</label>
          <textarea class="in" data-mail-body placeholder="Skriv ditt meddelande…"></textarea>
          <div class="mail__send">
            <div class="mode">
              <label><input type="radio" name="mode-${r.id}" value="now" checked data-mode>Skicka nu</label>
              <label><input type="radio" name="mode-${r.id}" value="later" data-mode>Schemalägg</label>
            </div>
            <input class="in when" type="datetime-local" data-mail-when />
            <button class="btn btn--sm" data-mail-send>Skicka →</button>
            <span class="hint" data-mail-hint></span>
          </div>
        </div>
      </div>`;
    }

    function wireCards() {
      listEl.querySelectorAll('.card').forEach(card => {
        const id = card.dataset.id;
        const row = all.find(r => r.id === id);

        // collapse / expand
        card.querySelector('.card__head').addEventListener('click', (e) => {
          if (e.target.closest('a')) return;
          card.classList.toggle('collapsed');
        });

        // lightbox on image thumbnails
        const imgs = (row?.file_urls || []).filter(u => IMG_RE.test(u));
        card.querySelectorAll('[data-lb]').forEach(a => a.addEventListener('click', (e) => {
          e.preventDefault();
          openLb(imgs, parseInt(a.dataset.lb, 10) || 0, row);
        }));

        // copy email
        card.querySelectorAll('[data-copy]').forEach(b => b.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(b.dataset.copy);
            b.textContent = '✓'; setTimeout(() => { b.textContent = '⧉'; }, 1200);
          } catch {}
        }));

        // status
        card.querySelector('[data-status]').addEventListener('change', async (e) => {
          const status = e.target.value;
          try {
            await api('update', { id, status });
            if (row) row.status = status;
            renderStats();
            card.dataset.status = status;
            const badge = card.querySelector('.badge');
            badge.className = 'badge badge--' + status;
            badge.textContent = STATUS_LABEL[status] || status;
          } catch { alert('Kunde inte uppdatera status.'); }
        });

        // notes
        card.querySelector('[data-save-notes]').addEventListener('click', async () => {
          const notes = card.querySelector('[data-notes]').value;
          const hint = card.querySelector('[data-hint]');
          try {
            await api('update', { id, internalNotes: notes });
            if (row) row.internal_notes = notes;
            hint.classList.add('show'); setTimeout(() => hint.classList.remove('show'), 1800);
          } catch { alert('Kunde inte spara anteckning.'); }
        });

        // delete
        card.querySelector('[data-delete]').addEventListener('click', async () => {
          if (!confirm('Ta bort den här ansökan permanent? Filerna raderas också.')) return;
          try {
            await api('delete', { id });
            all = all.filter(r => r.id !== id);
            renderStats(); render();
          } catch { alert('Kunde inte ta bort.'); }
        });

        // email composer
        const mail = card.querySelector('[data-mail]');
        card.querySelector('[data-mail-toggle]').addEventListener('click', () => mail.classList.toggle('open'));
        card.querySelectorAll('[data-tpl]').forEach(btn => btn.addEventListener('click', () => {
          const tpl = mailTemplate(btn.dataset.tpl, row || {});
          card.querySelector('[data-mail-subject]').value = tpl.subject;
          card.querySelector('[data-mail-body]').value = tpl.body;
        }));
        const whenEl = card.querySelector('[data-mail-when]');
        card.querySelectorAll('[data-mode]').forEach(radio => radio.addEventListener('change', () => {
          whenEl.classList.toggle('show', card.querySelector('[data-mode]:checked').value === 'later');
        }));
        const sendBtn = card.querySelector('[data-mail-send]');
        const hint = card.querySelector('[data-mail-hint]');
        sendBtn.addEventListener('click', async () => {
          hint.className = 'hint'; hint.textContent = '';
          const to = card.querySelector('[data-mail-to]').value.trim();
          const subject = card.querySelector('[data-mail-subject]').value.trim();
          const bodyText = card.querySelector('[data-mail-body]').value;
          const mode = card.querySelector('[data-mode]:checked').value;
          if (!to || !subject || !bodyText.trim()) { hint.className = 'hint err'; hint.textContent = 'Fyll i till, ämne och meddelande.'; return; }
          let scheduledAt;
          if (mode === 'later') {
            const v = whenEl.value;
            if (!v) { hint.className = 'hint err'; hint.textContent = 'Välj datum och tid.'; return; }
            const dt = new Date(v);
            if (isNaN(dt) || dt <= new Date()) { hint.className = 'hint err'; hint.textContent = 'Tiden måste vara i framtiden.'; return; }
            if (dt - new Date() > 72 * 3600 * 1000) { hint.className = 'hint err'; hint.textContent = 'Max 72 timmar fram i tiden.'; return; }
            scheduledAt = dt.toISOString();
          }
          sendBtn.disabled = true; sendBtn.textContent = 'Skickar…';
          try {
            await api('email', { id, to, subject, bodyText, scheduledAt });
            hint.className = 'hint ok';
            hint.textContent = scheduledAt ? `Schemalagt ✓ (${new Date(scheduledAt).toLocaleString('sv-SE')})` : 'Skickat ✓';
            // reflect in the history feed without a full reload
            (msgs[id] = msgs[id] || []).push({
              submission_id: id, direction: 'out', subject, body: bodyText,
              scheduled_at: scheduledAt || null, created_at: new Date().toISOString(),
            });
            const histEl = card.querySelector('[data-hist]');
            if (histEl) histEl.innerHTML = histItems(id);
          } catch {
            hint.className = 'hint err'; hint.textContent = 'Kunde inte skicka.';
          } finally {
            sendBtn.disabled = false; sendBtn.textContent = 'Skicka →';
          }
        });
      });
    }

    // ── Lightbox ──────────────────────────────────────────
    const lb      = document.getElementById('lb');
    const lbImg   = document.getElementById('lb-img');
    const lbCount = document.getElementById('lb-count');
    const lbPrev  = document.getElementById('lb-prev');
    const lbNext  = document.getElementById('lb-next');
    let lbItems = [], lbIdx = 0, lbRow = null;

    function slugify(s) {
      return String(s || 'bilder').toLowerCase()
        .replace(/[^a-z0-9åäö]+/gi, '-').replace(/^-+|-+$/g, '').slice(0, 60) || 'bilder';
    }
    function extOf(u) {
      const m = String(u).match(/\.([a-z0-9]{2,5})(?:\?|$)/i);
      return m ? m[1].toLowerCase() : 'jpg';
    }
    function lbShow() {
      lbImg.src = lbItems[lbIdx];
      lbCount.textContent = `${lbIdx + 1} / ${lbItems.length}`;
      lbPrev.disabled = lbNext.disabled = lbItems.length < 2;
    }
    function openLb(items, idx, row) {
      if (!items || !items.length) return;
      lbItems = items; lbIdx = Math.min(idx, items.length - 1); lbRow = row || null;
      lb.classList.add('open'); lb.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      lbShow();
    }
    function closeLb() {
      lb.classList.remove('open'); lb.setAttribute('aria-hidden', 'true');
      lbImg.src = ''; document.body.style.overflow = '';
    }
    lbPrev.addEventListener('click', () => { lbIdx = (lbIdx - 1 + lbItems.length) % lbItems.length; lbShow(); });
    lbNext.addEventListener('click', () => { lbIdx = (lbIdx + 1) % lbItems.length; lbShow(); });
    document.getElementById('lb-close').addEventListener('click', closeLb);
    lb.addEventListener('click', (e) => { if (e.target === lb) closeLb(); });
    document.addEventListener('keydown', (e) => {
      if (!lb.classList.contains('open')) return;
      if (e.key === 'Escape') closeLb();
      if (e.key === 'ArrowLeft') lbPrev.click();
      if (e.key === 'ArrowRight') lbNext.click();
    });
    let lbTouchX = null;
    lb.addEventListener('touchstart', (e) => { lbTouchX = e.touches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', (e) => {
      if (lbTouchX === null) return;
      const d = e.changedTouches[0].clientX - lbTouchX; lbTouchX = null;
      if (Math.abs(d) < 40 || lbItems.length < 2) return;
      (d < 0 ? lbNext : lbPrev).click();
    }, { passive: true });

    async function fetchBlob(url) {
      const r = await fetch(url);
      if (!r.ok) throw new Error('http ' + r.status);
      return await r.blob();
    }
    function saveBlob(blob, name) {
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob); a.download = name;
      document.body.appendChild(a); a.click();
      setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
    }
    // Download the photo currently in view
    document.getElementById('lb-dl').addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      const url = lbItems[lbIdx]; if (!url) return;
      btn.disabled = true;
      try {
        saveBlob(await fetchBlob(url), `${slugify(lbRow?.event_title)}-${lbIdx + 1}.${extOf(url)}`);
      } catch { window.open(url, '_blank'); }
      btn.disabled = false;
    });
    // Download every file of the submission as one zip (JSZip from CDN, lazy)
    document.getElementById('lb-dl-all').addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      const urls = (lbRow?.file_urls || lbItems).slice();
      if (!urls.length) return;
      const orig = btn.textContent;
      btn.disabled = true;
      try {
        const { default: JSZip } = await import('https://cdn.jsdelivr.net/npm/jszip@3.10.1/+esm');
        const zip = new JSZip();
        for (let i = 0; i < urls.length; i++) {
          btn.textContent = `Packar ${i + 1}/${urls.length}…`;
          zip.file(`${slugify(lbRow?.event_title)}-${i + 1}.${extOf(urls[i])}`, await fetchBlob(urls[i]));
        }
        btn.textContent = 'Skapar zip…';
        saveBlob(await zip.generateAsync({ type: 'blob' }), `${slugify(lbRow?.event_title)}.zip`);
      } catch {
        urls.forEach(u => window.open(u, '_blank'));
      }
      btn.textContent = orig; btn.disabled = false;
    });

    // toolbar
    searchEl.addEventListener('input', render);
    document.getElementById('refresh').addEventListener('click', () => loadList().catch(() => {}));
    document.querySelectorAll('.seg__btn').forEach(b => b.addEventListener('click', () => {
      sortBy = b.dataset.sort;
      document.querySelectorAll('.seg__btn').forEach(x => x.classList.toggle('active', x === b));
      render();
    }));
    document.getElementById('logout').addEventListener('click', () => {
      sessionStorage.removeItem('mhw-admin-pw'); password = '';
      appView.hidden = true; loginView.style.display = '';
    });

    // login
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      loginErr.textContent = '';
      password = pwInput.value;
      loginBtn.disabled = true; loginBtn.textContent = 'Loggar in…';
      try {
        loginView.style.display = 'none';
        appView.hidden = false;
        await loadList();
        sessionStorage.setItem('mhw-admin-pw', password);
      } catch (err) {
        appView.hidden = true; loginView.style.display = '';
        loginErr.textContent = err.message === 'unauthorized' ? 'Fel lösenord.' : 'Något gick fel.';
        password = '';
      } finally {
        loginBtn.disabled = false; loginBtn.textContent = 'Logga in →';
      }
    });

    // auto-login from session
    if (password) {
      loginView.style.display = 'none';
      appView.hidden = false;
      loadList().catch(() => {
        sessionStorage.removeItem('mhw-admin-pw'); password = '';
        appView.hidden = true; loginView.style.display = '';
      });
    }
  })();
  </script>
</body>
</html>
