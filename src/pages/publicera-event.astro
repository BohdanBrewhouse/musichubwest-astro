</style>

<script is:inline>
(function() {
  const form = document.getElementById('pub-form');
  const fileInput = document.getElementById('files');
  const fileList = document.getElementById('file-list');
  const submitBtn = document.getElementById('pub-submit');
  const errorEl = document.getElementById('pub-error');
  const successEl = document.getElementById('pub-success');
  if (!form) return;

  // File list rendering
  let files = [];
  const MAX_FILES = 5;
  const MAX_SIZE = 10 * 1024 * 1024; // 10MB
  const ALLOWED = ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];

  function renderFiles() {
    fileList.innerHTML = '';
    files.forEach((f, i) => {
      const li = document.createElement('li');
      const size = (f.size / 1024 / 1024).toFixed(1) + ' MB';
      li.innerHTML = '<span>' + escapeHtml(f.name) + ' · ' + size + '</span><button type="button" class="pub-form__file-remove" data-i="' + i + '">Ta bort</button>';
      fileList.appendChild(li);
    });
    fileList.querySelectorAll('.pub-form__file-remove').forEach(btn => {
      btn.addEventListener('click', () => {
        const i = parseInt(btn.dataset.i);
        files.splice(i, 1);
        renderFiles();
      });
    });
  }

  function escapeHtml(s) {
    return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  fileInput.addEventListener('change', (e) => {
    const newFiles = Array.from(e.target.files);
    for (const f of newFiles) {
      if (files.length >= MAX_FILES) { alert('Max ' + MAX_FILES + ' filer.'); break; }
      if (f.size > MAX_SIZE) { alert('"' + f.name + '" är större än 10 MB.'); continue; }
      if (!ALLOWED.includes(f.type)) { alert('"' + f.name + '" är inte ett tillåtet filformat.'); continue; }
      files.push(f);
    }
    renderFiles();
    fileInput.value = '';
  });

  // Submit (design-only — fakes success after 800ms)
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    errorEl.hidden = true;
    if (!form.checkValidity()) { form.reportValidity(); return; }
    if (form.elements.website && form.elements.website.value) return; // honeypot

    submitBtn.disabled = true;
    submitBtn.textContent = 'Skickar…';

    // TODO: wire up to /api/event-submission when backend is ready.
    setTimeout(() => {
      form.style.display = 'none';
      successEl.hidden = false;
      successEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 800);
  });
})();
</script>
