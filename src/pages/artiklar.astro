---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const lang = 'sv';
const articles = await getCollection('articles', a => a.id.startsWith('sv/'));
const sorted = articles.sort((a, b) => b.data.date.localeCompare(a.data.date));
const featured = sorted.find(a => a.data.featured) ?? sorted[0];
const rest = sorted.filter(a => a.id !== featured.id);

const badgeClass: Record<string, string> = {
  'Tune In West': 'badge--tiw',
  'Kulturverkstaden': 'badge--kv',
  'Högskolan för scen och musik': 'badge--hsm',
  'VGR': 'badge--vgr',
  'Scenen': 'badge--scenen',
};
---
<Base title="Artiklar – Music Hub West" lang={lang} description="Artiklar och nyheter om musikbranschens utveckling, AI och innovation i Västra Götaland. Reportage och reflektioner från Music Hub Wests aktörer.">
  <fragment slot="hreflang">
    <link rel="alternate" hreflang="sv" href={new URL('/artiklar', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/articles', Astro.site)} />
  </fragment>
  <fragment slot="jsonld">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Start", "item": Astro.site },
        { "@type": "ListItem", "position": 2, "name": "Artiklar", "item": new URL('/artiklar', Astro.site).toString() }
      ]
    })} />
  </fragment>

  <Nav lang={lang} active="articles" />

  <div class="page-hero">
    <div class="page-hero__inner">
      <h1 class="page-hero__title">Artiklar &amp;<br>Nyheter</h1>
      <p class="page-hero__subtitle">Reportage, reflektioner och nyheter från musikindustrins aktörer i Västra Götaland.</p>
    </div>
  </div>

  <section class="section">
    <div class="section__inner">
      <div class="filter-bar">
        <span class="filter-bar__label">Filtrera</span>
        <button class="filter-chip active" data-filter="all" aria-pressed="true">Alla</button>
        <button class="filter-chip" data-filter="Tune In West" aria-pressed="false">Tune In West</button>
        <button class="filter-chip" data-filter="Kulturverkstaden" aria-pressed="false">Kulturverkstaden</button>
        <button class="filter-chip" data-filter="Högskolan för scen och musik" aria-pressed="false">Högskolan för scen och musik</button>
        <button class="filter-chip" data-filter="VGR" aria-pressed="false">VGR</button>
      </div>

      <a id="featured-article" class="art-feature" href={`/artiklar/${featured.id.replace('sv/', '')}`}
         data-category={featured.data.category}>
        {featured.data.image && (
          <div class="art-feature__img">
            <Image src={featured.data.image} alt="" width={1400} height={900} quality={80} loading="eager" decoding="async" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 60vw" />
          </div>
        )}
        <div class="art-feature__body">
          <span class={`badge ${badgeClass[featured.data.category]}`}>{featured.data.category}</span>
          <h2 class="featured-title art-feature__title"><span>{featured.data.title}</span></h2>
          <p class="art-feature__meta">{featured.data.author} &nbsp;·&nbsp; {featured.data.date}</p>
          <p class="art-feature__lead"><span data-i18n="art.feat.desc">{featured.body.slice(0, 180)}...</span></p>
        </div>
      </a>

      <div class="card-grid">
        {rest.map(a => (
          <ArticleCard
            title={a.data.title}
            author={a.data.author}
            date={a.data.date}
            category={a.data.category}
            description={a.body.slice(0, 120) + '...'}
            slug={a.id.replace('sv/', '')}
            image={a.data.image}
            lang={lang}
          />
        ))}
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</Base>
