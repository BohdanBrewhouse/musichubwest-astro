---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import EventCard from '../components/EventCard.astro';
import EventsMap from '../components/EventsMap.astro';
import { getCollection } from 'astro:content';
import geocache from '../data/geocache.json';

const lang = 'sv';
// Toggle to show/hide the "Publicera ditt event" CTA banner at the bottom
// of the events page. Set to true when the submission backend is wired up.
const SHOW_PUBLISH_CTA = false;
const events = await getCollection('events', e => e.id.startsWith('sv/'));
const sorted = events.sort((a, b) => a.data.date.localeCompare(b.data.date));

const today = new Date().toISOString().split('T')[0];
const upcoming = sorted.filter(ev => ev.data.date >= today);
const past     = sorted.filter(ev => ev.data.date < today).reverse();

// Build map markers: only upcoming events that successfully geocoded.
type Geo = { lat: number | null; lng: number | null };
const cache = geocache as Record<string, Geo>;
const pickQuery = (ev: typeof sorted[number]) =>
  ev.data.address || ev.data.map_query || (ev.data.location ? `${ev.data.location}, Sweden` : null);

const mapMarkers = upcoming
  .map(ev => {
    const q = pickQuery(ev);
    if (!q) return null;
    const hit = cache[q];
    if (!hit?.lat || !hit?.lng) return null;
    return {
      slug: ev.id.replace('sv/', ''),
      lat: hit.lat,
      lng: hit.lng,
      title: ev.data.title,
      date: ev.data.date,
      time: ev.data.time,
      location: ev.data.location,
      image: ev.data.card_image ?? ev.data.image,
      category: ev.data.category,
      organizer: ev.data.organizer ?? null,
      isOwn: !ev.data.external_registration_url,
      eventType: ev.data.event_type ?? null,
    };
  })
  .filter((m): m is NonNullable<typeof m> => m !== null);

const monthsFull = ['Januari','Februari','Mars','April','Maj','Juni','Juli','Augusti','September','Oktober','November','December'];

const upcomingGroups: Record<string, typeof sorted> = {};
for (const ev of upcoming) {
  const [year, month] = ev.data.date.split('-');
  const key = `${year}-${month}`;
  if (!upcomingGroups[key]) upcomingGroups[key] = [];
  upcomingGroups[key].push(ev);
}

const pastGroups: Record<string, typeof sorted> = {};
for (const ev of past) {
  const [year, month] = ev.data.date.split('-');
  const key = `${year}-${month}`;
  if (!pastGroups[key]) pastGroups[key] = [];
  pastGroups[key].push(ev);
}

const badgeClass: Record<string, string> = {
  'Tune In West': 'badge--tiw',
  'Kulturverkstaden': 'badge--kv',
  'Högskolan för scen och musik': 'badge--hsm',
  'VGR': 'badge--vgr',
  'Partners': 'badge--partner',
  'Externa event': 'badge--partner',
  'Kulturakademin': 'badge--kulturakademin',
};

function formatDate(d: string) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(d)) return d;
  return new Intl.DateTimeFormat('sv-SE', { day: 'numeric', month: 'long', year: 'numeric' })
    .format(new Date(d + 'T12:00:00'));
}
---
<Base title="Event – Music Hub West" lang={lang} description="Kommande event inom musik, teknik och kreativt företagande i Västra Götaland. Seminarier, showcases och branschträffar arrangerade av Music Hub West.">
  <fragment slot="hreflang">
    <link rel="alternate" hreflang="sv" href={new URL('/evenemang', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/events', Astro.site)} />
  </fragment>
  <fragment slot="jsonld">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Start", "item": Astro.site },
        { "@type": "ListItem", "position": 2, "name": "Event", "item": new URL('/evenemang', Astro.site).toString() }
      ]
    })} />
  </fragment>

  <Nav lang={lang} active="events" />

  <!-- Page header -->
  <div class="ev-header">
    <div class="ev-header__inner">
      <div class="ev-header__row">
        <div class="ev-header__left">
          <p class="ev-header__kicker">Music Hub West</p>
          <h1 class="ev-header__title">Evenemang</h1>
        </div>
        <div class="ev-header__right">
          <span class="ev-header__num" id="ev-count">{upcoming.length}</span>
          <span class="ev-header__num-label" id="ev-count-label">kommande<br>event</span>
        </div>
      </div>

      <div class="ev-header__bottom">

        <!-- Desktop: filter chips -->
        <div class="ev-filter-chips" id="ev-filter-chips">
          <button class="ev-chip active" data-filter="all">Alla</button>
          <button class="ev-chip" data-filter="Tune In West">Tune In West</button>
          <button class="ev-chip" data-filter="Kulturverkstaden">Kulturverkstaden</button>
          <button class="ev-chip" data-filter="Högskolan för scen och musik">Högskolan för scen och musik</button>
          <button class="ev-chip" data-filter="VGR">VGR</button>
          <button class="ev-chip" data-filter="Partners">Partners</button>
          <button class="ev-chip" data-filter="Kulturakademin">Kulturakademin</button>
        </div>

        <!-- Mobile: dropdown -->
        <div class="cat-drop" id="cat-drop">
          <button class="cat-drop__btn" id="cat-drop__btn" aria-haspopup="listbox" aria-expanded="false">
            <span id="cat-drop__label">Alla kategorier</span>
            <svg class="cat-drop__caret" width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul class="cat-drop__menu" role="listbox" id="cat-drop__menu" hidden>
            <li class="cat-drop__item active" role="option" data-filter="all" aria-selected="true">Alla</li>
            <li class="cat-drop__item" role="option" data-filter="Tune In West" aria-selected="false">Tune In West</li>
            <li class="cat-drop__item" role="option" data-filter="Kulturverkstaden" aria-selected="false">Kulturverkstaden</li>
            <li class="cat-drop__item" role="option" data-filter="Högskolan för scen och musik" aria-selected="false">Högskolan för scen och musik</li>
            <li class="cat-drop__item" role="option" data-filter="VGR" aria-selected="false">VGR</li>
            <li class="cat-drop__item" role="option" data-filter="Partners" aria-selected="false">Partners</li>
            <li class="cat-drop__item" role="option" data-filter="Kulturakademin" aria-selected="false">Kulturakademin</li>
          </ul>
        </div>

        <!-- View toggle -->
        <div class="view-toggle-wrap">
          <div class="view-toggle" role="group" aria-label="Välj vy">
          <button class="view-toggle__btn active" id="btn-grid" aria-pressed="true">
            <svg width="18" height="18" viewBox="0 0 100 100" fill="none">
              <path d="M16.6665 20.8327C16.6665 19.7276 17.1055 18.6678 17.8869 17.8864C18.6683 17.105 19.7281 16.666 20.8332 16.666H37.4998C38.6049 16.666 39.6647 17.105 40.4461 17.8864C41.2275 18.6678 41.6665 19.7276 41.6665 20.8327V37.4994C41.6665 38.6044 41.2275 39.6642 40.4461 40.4456C39.6647 41.227 38.6049 41.666 37.4998 41.666H20.8332C19.7281 41.666 18.6683 41.227 17.8869 40.4456C17.1055 39.6642 16.6665 38.6044 16.6665 37.4994V20.8327Z" stroke="currentColor" stroke-width="8.33333" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M58.3332 20.8327C58.3332 19.7276 58.7722 18.6678 59.5536 17.8864C60.335 17.105 61.3948 16.666 62.4998 16.666H79.1665C80.2716 16.666 81.3314 17.105 82.1128 17.8864C82.8942 18.6678 83.3332 19.7276 83.3332 20.8327V37.4994C83.3332 38.6044 82.8942 39.6642 82.1128 40.4456C81.3314 41.227 80.2716 41.666 79.1665 41.666H62.4998C61.3948 41.666 60.335 41.227 59.5536 40.4456C58.7722 39.6642 58.3332 38.6044 58.3332 37.4994V20.8327Z" stroke="currentColor" stroke-width="8.33333" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M16.6665 62.4994C16.6665 61.3943 17.1055 60.3345 17.8869 59.5531C18.6683 58.7717 19.7281 58.3327 20.8332 58.3327H37.4998C38.6049 58.3327 39.6647 58.7717 40.4461 59.5531C41.2275 60.3345 41.6665 61.3943 41.6665 62.4994V79.166C41.6665 80.2711 41.2275 81.3309 40.4461 82.1123C39.6647 82.8937 38.6049 83.3327 37.4998 83.3327H20.8332C19.7281 83.3327 18.6683 82.8937 17.8869 82.1123C17.1055 81.3309 16.6665 80.2711 16.6665 79.166V62.4994Z" stroke="currentColor" stroke-width="8.33333" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M58.3332 62.4994C58.3332 61.3943 58.7722 60.3345 59.5536 59.5531C60.335 58.7717 61.3948 58.3327 62.4998 58.3327H79.1665C80.2716 58.3327 81.3314 58.7717 82.1128 59.5531C82.8942 60.3345 83.3332 61.3943 83.3332 62.4994V79.166C83.3332 80.2711 82.8942 81.3309 82.1128 82.1123C81.3314 82.8937 80.2716 83.3327 79.1665 83.3327H62.4998C61.3948 83.3327 60.335 82.8937 59.5536 82.1123C58.7722 81.3309 58.3332 80.2711 58.3332 79.166V62.4994Z" stroke="currentColor" stroke-width="8.33333" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="view-toggle__tooltip">Grid view</span>
          </button>
          <button class="view-toggle__btn" id="btn-list" aria-pressed="false">
            <svg width="18" height="18" viewBox="0 0 100 100" fill="none">
              <path d="M16.6665 24.9993C16.6665 22.7892 17.5445 20.6696 19.1073 19.1068C20.6701 17.544 22.7897 16.666 24.9998 16.666H74.9998C77.21 16.666 79.3296 17.544 80.8924 19.1068C82.4552 20.6696 83.3332 22.7892 83.3332 24.9993V33.3327C83.3332 35.5428 82.4552 37.6624 80.8924 39.2252C79.3296 40.788 77.21 41.666 74.9998 41.666H24.9998C22.7897 41.666 20.6701 40.788 19.1073 39.2252C17.5445 37.6624 16.6665 35.5428 16.6665 33.3327V24.9993Z" stroke="currentColor" stroke-width="8.33333" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M16.6665 66.666C16.6665 64.4559 17.5445 62.3363 19.1073 60.7735C20.6701 59.2107 22.7897 58.3327 24.9998 58.3327H74.9998C77.21 58.3327 79.3296 59.2107 80.8924 60.7735C82.4552 62.3363 83.3332 64.4559 83.3332 66.666V74.9993C83.3332 77.2095 82.4552 79.3291 80.8924 80.8919C79.3296 82.4547 77.21 83.3327 74.9998 83.3327H24.9998C22.7897 83.3327 20.6701 82.4547 19.1073 80.8919C17.5445 79.3291 16.6665 77.2095 16.6665 74.9993V66.666Z" stroke="currentColor" stroke-width="8.33333" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="view-toggle__tooltip">Agenda view</span>
          </button>
          <button class="view-toggle__btn" id="btn-map" aria-pressed="false">
            <svg width="18" height="18" viewBox="0 0 100 100" fill="none">
              <path d="M62.5 29.166L37.5 16.666L12.5 29.166V83.3327L37.5 70.8327M37.5 16.666V70.8327M37.5 70.8327L62.5 83.3327L87.5 70.8327V16.666L62.5 29.166M62.5 29.166V83.3327" stroke="currentColor" stroke-width="8.33333" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="view-toggle__tooltip">Map view</span>
          </button>
        </div>
        </div><!-- /view-toggle-wrap -->
      </div>
    </div>
  </div>

  <!-- GRID VIEW -->
  <section class="section ev-view" id="view-grid">
    <div class="section__inner">
      <!-- Upcoming -->
      <div class="card-grid" id="grid-upcoming">
        {upcoming.map(ev => (
          <EventCard
            title={ev.data.title}
            date={ev.data.date}
            time={ev.data.time}
            category={ev.data.category}
            image={ev.data.card_image ?? ev.data.image}
            slug={ev.id.replace('sv/', '')}
            lang={lang}
            organizer={ev.data.organizer}
            isOwn={!ev.data.external_registration_url}
            eventType={ev.data.event_type}
            eventLanguage={ev.data.event_language}
            location={ev.data.location}
          />
        ))}
        {upcoming.length === 0 && (
          <p class="ev-empty">Inga kommande event just nu. Kolla tillbaka snart!</p>
        )}
      </div>
      <!-- Archive -->
      <div class="card-grid" id="grid-archive" style="display:none">
        {past.map(ev => (
          <EventCard
            title={ev.data.title}
            date={ev.data.date}
            time={ev.data.time}
            category={ev.data.category}
            image={ev.data.card_image ?? ev.data.image}
            slug={ev.id.replace('sv/', '')}
            lang={lang}
            past={true}
            organizer={ev.data.organizer}
            isOwn={!ev.data.external_registration_url}
            eventType={ev.data.event_type}
            eventLanguage={ev.data.event_language}
            location={ev.data.location}
          />
        ))}
        {past.length === 0 && (
          <p class="ev-empty">Inga tidigare event ännu.</p>
        )}
      </div>
    </div>
  </section>

  <!-- LIST VIEW -->
  <div class="agenda ev-view" id="view-list" style="display:none">
    <div class="agenda__inner">

      <!-- List: Upcoming -->
      <div id="list-upcoming">
        {Object.entries(upcomingGroups).map(([key, evs]) => {
          const [year, monthIdx] = key.split('-');
          const mIdx = parseInt(monthIdx, 10) - 1;
          return (
            <div class="agenda-month" data-month-key={key}>
              <div class="agenda-month__label">
                <span class="agenda-month__name">{monthsFull[mIdx]}</span>
                <span class="agenda-month__year">{year}</span>
              </div>
              {evs.map((ev) => {
                const slug = ev.id.replace('sv/', '');
                const evIsOwn = !ev.data.external_registration_url;
                const arrangerName = evIsOwn ? 'Music Hub West' : (ev.data.organizer ?? '');
                const evIsUtlysning = ev.data.event_type === 'Utlysning';
                const evIsPartner = ev.data.category === 'Partners' || ev.data.category === 'Externa event';
                const evBadgeText = evIsPartner ? (ev.data.organizer ?? 'Partner') : ev.data.category;
                const evShowArranger = !evIsPartner && arrangerName;
                const evLangNorm = ev.data.event_language?.toLowerCase() ?? '';
                const evLangChip = evLangNorm === 'engelska' || evLangNorm === 'english' ? 'Engelska'
                  : evLangNorm === 'tvåspråkigt' || evLangNorm === 'bilingual' ? 'Tvåspråkigt'
                  : null;
                return (
                  <a class={`agenda-item${evIsOwn ? ' agenda-item--own' : ''}`} href={`/evenemang/${slug}`} data-category={ev.data.category}>
                    <div class="agenda-item__body">
                      <div class="agenda-item__top">
                        <span class={`badge ${badgeClass[ev.data.category] ?? ''}`}>{evBadgeText}</span>
                        {evIsUtlysning && <span class="agenda-item__utlysning-chip">Utlysning</span>}
                        {evLangChip && <span class="agenda-item__lang-chip">{evLangChip}</span>}
                        <h2 class="agenda-item__title">{ev.data.title}</h2>
                      </div>
                      <p class="agenda-item__meta">
                        {evIsUtlysning
                          ? <><span>{ev.data.time}</span><span class="agenda-item__dot">·</span><span>{formatDate(ev.data.date)}</span></>
                          : <><span>{formatDate(ev.data.date)}</span>{ev.data.location && <><span class="agenda-item__dot">·</span><span>{ev.data.location}</span></>}{ev.data.time && <><span class="agenda-item__dot">·</span><span>{ev.data.time}</span></>}</>
                        }
                      </p>
                      {evShowArranger && <p class={`agenda-item__arranger${evIsOwn ? ' agenda-item__arranger--own' : ''}`}>Arrangör · {arrangerName}</p>}
                    </div>
                    <span class="agenda-item__link">
                      {ev.data.registration_open ? 'Anmäl dig' : 'Läs mer'}
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </a>
                );
              })}
            </div>
          );
        })}
        {upcoming.length === 0 && (
          <p class="ev-empty">Inga kommande event just nu. Kolla tillbaka snart!</p>
        )}
      </div>

      <!-- List: Archive -->
      <div id="list-archive" style="display:none">
        {Object.entries(pastGroups).map(([key, evs]) => {
          const [year, monthIdx] = key.split('-');
          const mIdx = parseInt(monthIdx, 10) - 1;
          return (
            <div class="agenda-month" data-month-key={key}>
              <div class="agenda-month__label">
                <span class="agenda-month__name">{monthsFull[mIdx]}</span>
                <span class="agenda-month__year">{year}</span>
              </div>
              {evs.map((ev) => {
                const slug = ev.id.replace('sv/', '');
                const evIsOwn = !ev.data.external_registration_url;
                const arrangerName = evIsOwn ? 'Music Hub West' : (ev.data.organizer ?? '');
                const evIsUtlysning = ev.data.event_type === 'Utlysning';
                const evIsPartner = ev.data.category === 'Partners' || ev.data.category === 'Externa event';
                const evBadgeText = evIsPartner ? (ev.data.organizer ?? 'Partner') : ev.data.category;
                const evShowArranger = !evIsPartner && arrangerName;
                const evLangNorm = ev.data.event_language?.toLowerCase() ?? '';
                const evLangChip = evLangNorm === 'engelska' || evLangNorm === 'english' ? 'Engelska'
                  : evLangNorm === 'tvåspråkigt' || evLangNorm === 'bilingual' ? 'Tvåspråkigt'
                  : null;
                return (
                  <a class={`agenda-item agenda-item--past${evIsOwn ? ' agenda-item--own' : ''}`} href={`/evenemang/${slug}`} data-category={ev.data.category}>
                    <div class="agenda-item__body">
                      <div class="agenda-item__top">
                        <span class={`badge ${badgeClass[ev.data.category] ?? ''}`}>{evBadgeText}</span>
                        {evIsUtlysning && <span class="agenda-item__utlysning-chip">Utlysning</span>}
                        {evLangChip && <span class="agenda-item__lang-chip">{evLangChip}</span>}
                        <h2 class="agenda-item__title">{ev.data.title}</h2>
                      </div>
                      <p class="agenda-item__meta">
                        {evIsUtlysning
                          ? <><span>{ev.data.time}</span><span class="agenda-item__dot">·</span><span>{formatDate(ev.data.date)}</span></>
                          : <><span>{formatDate(ev.data.date)}</span>{ev.data.location && <><span class="agenda-item__dot">·</span><span>{ev.data.location}</span></>}{ev.data.time && <><span class="agenda-item__dot">·</span><span>{ev.data.time}</span></>}</>
                        }
                      </p>
                      {evShowArranger && <p class={`agenda-item__arranger${evIsOwn ? ' agenda-item__arranger--own' : ''}`}>Arrangör · {arrangerName}</p>}
                    </div>
                    <span class="agenda-item__link">
                      Läs mer
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </a>
                );
              })}
            </div>
          );
        })}
        {past.length === 0 && (
          <p class="ev-empty">Inga tidigare event ännu.</p>
        )}
      </div>

      <div id="agenda-empty" hidden>
        <p class="agenda-empty">Inga event matchar det valda filtret.</p>
      </div>
    </div>
  </div>

  <!-- MAP VIEW -->
  <EventsMap markers={mapMarkers} lang={lang} />

  <!-- PUBLISH-YOUR-EVENT CTA (toggle SHOW_PUBLISH_CTA above) -->
  {SHOW_PUBLISH_CTA && (
    <section class="ev-cta">
      <div class="ev-cta__inner">
        <div class="ev-cta__text">
          <p class="ev-cta__kicker">FÖR ARRANGÖRER</p>
          <h2 class="ev-cta__title">Arrangerar du<br/>ett event?</h2>
          <p class="ev-cta__lead">Publicera det gratis på Music Hub West — vi designar omslaget och pushar i våra sociala kanaler.</p>
        </div>
        <a href="/publicera-event" class="btn btn--primary ev-cta__btn">Skicka in ditt event →</a>
      </div>
    </section>
  )}

  <Footer lang={lang} />

  <!-- Floating tab pill -->
  <div class="ev-floating" id="ev-floating">
    <button class="ev-float-tab active" data-tab="upcoming">Kommande</button>
    <button class="ev-float-tab" data-tab="archive">
      Arkiv
      {past.length > 0 && <span class="ev-float-count">{past.length}</span>}
    </button>
  </div>
</Base>

<script is:inline>
(function () {
  var STORAGE_KEY = 'mhw-events-view';

  var btnGrid = document.getElementById('btn-grid');
  var btnList = document.getElementById('btn-list');
  var btnMap  = document.getElementById('btn-map');
  var viewGrid = document.getElementById('view-grid');
  var viewList = document.getElementById('view-list');
  var viewMap  = document.getElementById('view-map');
  var evFloating = document.getElementById('ev-floating'); // Kommande/Arkiv pill

  function setView(v) {
    var view = (v === 'list' || v === 'map') ? v : 'grid';
    var isGrid = view === 'grid';
    var isList = view === 'list';
    var isMap  = view === 'map';
    if (viewGrid) viewGrid.style.display = isGrid ? '' : 'none';
    if (viewList) viewList.style.display = isList ? '' : 'none';
    if (viewMap)  {
      viewMap.style.display = isMap ? '' : 'none';
      viewMap.setAttribute('aria-hidden', isMap ? 'false' : 'true');
    }
    if (btnGrid) { btnGrid.classList.toggle('active', isGrid); btnGrid.setAttribute('aria-pressed', isGrid ? 'true' : 'false'); }
    if (btnList) { btnList.classList.toggle('active', isList); btnList.setAttribute('aria-pressed', isList ? 'true' : 'false'); }
    if (btnMap)  { btnMap.classList.toggle('active', isMap);   btnMap.setAttribute('aria-pressed', isMap  ? 'true' : 'false'); }
    // Map only shows upcoming → hide the Kommande/Arkiv pill while in map view.
    if (evFloating) evFloating.style.display = isMap ? 'none' : '';
    if (isMap) {
      try {
        // Force-switch to Kommande tab when entering map view so filtering stays sane.
        var upcomingBtn = document.querySelector('[data-tab="upcoming"]');
        if (upcomingBtn && !upcomingBtn.classList.contains('active')) upcomingBtn.click();
      } catch(e) {}
      if (typeof window.__initEventsMap === 'function') window.__initEventsMap();
      if (typeof window.__refreshEventsMap === 'function') window.__refreshEventsMap();
    }
    try { localStorage.setItem(STORAGE_KEY, view); } catch(e) {}
  }

  // Restore saved view preference
  try {
    var saved = localStorage.getItem(STORAGE_KEY);
    if (saved === 'list' || saved === 'map') setView(saved);
  } catch(e) {}

  btnGrid.addEventListener('click', function() { setView('grid'); });
  btnList.addEventListener('click', function() { setView('list'); });
  if (btnMap) btnMap.addEventListener('click', function() { setView('map'); });

  // ── Tab switching ──
  var gridUpcoming = document.getElementById('grid-upcoming');
  var gridArchive  = document.getElementById('grid-archive');
  var listUpcoming = document.getElementById('list-upcoming');
  var listArchive  = document.getElementById('list-archive');
  var evCount      = document.getElementById('ev-count');
  var evCountLabel = document.getElementById('ev-count-label');

  var upcomingCount = gridUpcoming ? gridUpcoming.querySelectorAll('[data-category]').length : 0;
  var archiveCount  = gridArchive  ? gridArchive.querySelectorAll('[data-category]').length  : 0;

  function setTab(tab) {
    var isUpcoming = tab !== 'archive';
    if (gridUpcoming) gridUpcoming.style.display = isUpcoming ? '' : 'none';
    if (gridArchive)  gridArchive.style.display  = isUpcoming ? 'none' : '';
    if (listUpcoming) listUpcoming.style.display = isUpcoming ? '' : 'none';
    if (listArchive)  listArchive.style.display  = isUpcoming ? 'none' : '';
    // sync all [data-tab] buttons (floating pill)
    document.querySelectorAll('[data-tab]').forEach(function(btn) {
      btn.classList.toggle('active', btn.dataset.tab === tab);
    });
    if (evCount) evCount.textContent = isUpcoming ? upcomingCount : archiveCount;
    if (evCountLabel) evCountLabel.innerHTML = isUpcoming ? 'kommande<br>event' : 'tidigare<br>event';
    // reset category filter
    document.querySelectorAll('.ev-chip').forEach(function(c) { c.classList.remove('active'); });
    var allChip = document.querySelector('.ev-chip[data-filter="all"]');
    if (allChip) allChip.classList.add('active');
    if (catLabel) catLabel.textContent = 'Alla kategorier';
    if (catMenu) {
      catMenu.querySelectorAll('.cat-drop__item').forEach(function(i) {
        i.classList.remove('active');
        i.setAttribute('aria-selected', 'false');
      });
      var allItem = catMenu.querySelector('.cat-drop__item[data-filter="all"]');
      if (allItem) { allItem.classList.add('active'); allItem.setAttribute('aria-selected', 'true'); }
    }
    applyFilter('all');
    try { localStorage.setItem('mhw-events-tab', tab); } catch(e) {}
  }

  // Wire up all [data-tab] buttons → floating pill
  document.querySelectorAll('[data-tab]').forEach(function(btn) {
    btn.addEventListener('click', function() { setTab(btn.dataset.tab); });
  });

  // Restore saved tab
  try {
    var savedTab = localStorage.getItem('mhw-events-tab');
    if (savedTab === 'archive') setTab('archive');
  } catch(e) {}

  // ── Desktop chip filter ──
  document.querySelectorAll('.ev-chip').forEach(function(chip) {
    chip.addEventListener('click', function() {
      document.querySelectorAll('.ev-chip').forEach(function(c) { c.classList.remove('active'); });
      chip.classList.add('active');
      applyFilter(chip.getAttribute('data-filter'));
    });
  });

  // ── Category dropdown filter ──
  var catBtn   = document.getElementById('cat-drop__btn');
  var catMenu  = document.getElementById('cat-drop__menu');
  var catLabel = document.getElementById('cat-drop__label');

  function applyFilter(filter) {
    document.querySelectorAll('[data-category]').forEach(function(el) {
      el.style.display = (filter === 'all' || el.dataset.category === filter) ? '' : 'none';
    });
    requestAnimationFrame(function() {
      var anyVisible = false;
      document.querySelectorAll('.agenda-month').forEach(function(group) {
        var items = group.querySelectorAll('.agenda-item');
        var hasVisible = Array.from(items).some(function(el) { return el.style.display !== 'none'; });
        group.style.display = hasVisible ? '' : 'none';
        if (hasVisible) anyVisible = true;
      });
      var empty = document.getElementById('agenda-empty');
      if (empty) empty.hidden = anyVisible;
    });
  }

  if (catBtn && catMenu) {
    catBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      var isOpen = !catMenu.hidden;
      catMenu.hidden = isOpen;
      catBtn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
    });

    catMenu.querySelectorAll('.cat-drop__item').forEach(function(item) {
      item.addEventListener('click', function() {
        var filter = item.getAttribute('data-filter');
        catLabel.textContent = filter === 'all' ? 'Alla kategorier' : item.textContent.trim();
        catMenu.querySelectorAll('.cat-drop__item').forEach(function(i) {
          i.classList.remove('active');
          i.setAttribute('aria-selected', 'false');
        });
        item.classList.add('active');
        item.setAttribute('aria-selected', 'true');
        catMenu.hidden = true;
        catBtn.setAttribute('aria-expanded', 'false');
        applyFilter(filter);
      });
    });

    document.addEventListener('click', function() {
      catMenu.hidden = true;
      catBtn.setAttribute('aria-expanded', 'false');
    });
  }
})();
</script>

