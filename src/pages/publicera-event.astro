---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
const lang = 'sv';
---
<Base
  title="Publicera ditt event – Music Hub West"
  lang={lang}
  description="Arrangerar du en föreläsning, workshop eller branschträff i Västra Götaland? Den här tjänsten är till för dig som är aktör inom musikbranschen i regionen — vi designar omslaget och delar det i våra kanaler."
>
  <Nav lang={lang} />

  <!-- ─── HERO ─────────────────────────────── -->
  <section class="pub-hero">
    <div class="pub-hero__inner">
      <p class="pub-eyebrow">FÖR DIG SOM VILL SYNAS PÅ MUSIC HUB WEST</p>
      <h1 class="pub-hero__title">
        Publicera<br>
        ditt event<br>
        <span class="pub-hero__title-lime">/ händelse</span>
      </h1>
      <p class="pub-hero__lead">
        Arrangerar du en föreläsning, workshop eller annat som är av intresse
        för musikbranschen? Den här tjänsten är till för dig som är aktör i
        Västra Götaland — vi designar omslaget åt dig och delar det i Music
        Hub Wests sociala kanaler.
      </p>
      <div class="pub-hero__ctas">
        <a href="#formulär" class="btn btn--primary">Skicka in ditt event →</a>
        <a href="#hur" class="btn btn--ghost">Hur funkar det?</a>
      </div>
    </div>
  </section>

  <!-- ─── VAD DU FÅR ───────────────────────── -->
  <section class="pub-value">
    <div class="pub-value__inner">
      <p class="pub-eyebrow">VAD DU FÅR</p>
      <h2 class="pub-section__title">Fyra saker.<br>För aktörer i regionen.</h2>
      <div class="pub-value__grid">
        <div class="pub-value__item">
          <div class="pub-value__num">01</div>
          <h3 class="pub-value__heading">Plats i kalendern</h3>
          <p class="pub-value__text">Ditt event syns på musichubwest.com/evenemang — där folk faktiskt letar efter musikevent i regionen.</p>
        </div>
        <div class="pub-value__item">
          <div class="pub-value__num">02</div>
          <h3 class="pub-value__heading">Custom omslag</h3>
          <p class="pub-value__text">Vår in-house designer skapar ett omslag som matchar vårt brand — du behöver inte vara grafiker.</p>
        </div>
        <div class="pub-value__item">
          <div class="pub-value__num">03</div>
          <h3 class="pub-value__heading">Push i sociala kanaler</h3>
          <p class="pub-value__text">Instagram · LinkedIn · Facebook · TikTok. Ditt event når vår community direkt.</p>
        </div>
        <div class="pub-value__item">
          <div class="pub-value__num">04</div>
          <h3 class="pub-value__heading">Vi länkar till dig</h3>
          <p class="pub-value__text">Din egen biljettlänk eller anmälan finns alltid med — vi bygger trafik till dig, inte till oss.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── PROCESS ──────────────────────────── -->
  <section class="pub-process" id="hur">
    <div class="pub-process__inner">
      <p class="pub-eyebrow">SÅ FUNKAR DET</p>
      <h2 class="pub-section__title">Fyra steg.<br>Inget krångel.</h2>
      <ol class="pub-process__steps">
        <li class="pub-process__step">
          <span class="pub-process__step-num">01</span>
          <div>
            <h3 class="pub-process__step-title">Du skickar in</h3>
            <p class="pub-process__step-text">Fyll i formuläret nedan — namn, eventdetaljer och eventuella bilder du har. Tar ca 3 minuter.</p>
          </div>
        </li>
        <li class="pub-process__step">
          <span class="pub-process__step-num">02</span>
          <div>
            <h3 class="pub-process__step-title">Vi granskar</h3>
            <p class="pub-process__step-text">Inom 5 arbetsdagar återkommer vi med besked — om eventet passar och kan publiceras.</p>
          </div>
        </li>
        <li class="pub-process__step">
          <span class="pub-process__step-num">03</span>
          <div>
            <h3 class="pub-process__step-title">Vi designar</h3>
            <p class="pub-process__step-text">Vår designer tar fram ett omslag som matchar Music Hub West — tar oftast 3–5 dagar.</p>
          </div>
        </li>
        <li class="pub-process__step">
          <span class="pub-process__step-num">04</span>
          <div>
            <h3 class="pub-process__step-title">Publicerat!</h3>
            <p class="pub-process__step-text">Ditt event är live på sajten — och i våra sociala kanaler. Klart.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ─── PARTNERS / VEM ÄR VI ─────────────── -->
  <section class="pub-about">
    <div class="pub-about__inner">
      <p class="pub-eyebrow">VEM ÄR VI</p>
      <h2 class="pub-section__title">Music Hub West.<br>Plattformen för musikbranschen.</h2>
      <p class="pub-about__text">
        Music Hub West är en mötesplats för musikbranschen i Västra Götaland.
        Vi drivs av projektet <strong>Tune In West</strong> — en regional satsning
        2026–2029 som backas av fem starka partners:
      </p>
      <div class="pub-about__partners">
        <span class="pub-partner-chip">Västra Götalandsregionen</span>
        <span class="pub-partner-chip">Tillväxtverket</span>
        <span class="pub-partner-chip">Kulturförvaltningen i VGR</span>
        <span class="pub-partner-chip">Brewhouse Inkubator</span>
        <span class="pub-partner-chip">Högskolan för scen och musik</span>
      </div>
      <a href="/om" class="pub-about__link">Läs mer om projektet →</a>
    </div>
  </section>

  <!-- ─── SOCIAL REACH ─────────────────────── -->
  <section class="pub-reach">
    <div class="pub-reach__inner">
      <p class="pub-eyebrow">VÅRA KANALER</p>
      <h2 class="pub-section__title">Vi når musikbranschen<br>där den finns.</h2>
      <div class="pub-reach__grid">
        <a href="https://instagram.com/musichubwest" target="_blank" rel="noopener" class="pub-reach__item">
          <span class="pub-reach__platform">Instagram</span>
          <span class="pub-reach__handle">@musichubwest</span>
        </a>
        <a href="https://www.linkedin.com/company/music-hub-west" target="_blank" rel="noopener" class="pub-reach__item">
          <span class="pub-reach__platform">LinkedIn</span>
          <span class="pub-reach__handle">Music Hub West</span>
        </a>
        <a href="https://www.facebook.com/musichubwest" target="_blank" rel="noopener" class="pub-reach__item">
          <span class="pub-reach__platform">Facebook</span>
          <span class="pub-reach__handle">@musichubwest</span>
        </a>
        <a href="https://www.tiktok.com/@musichubwest" target="_blank" rel="noopener" class="pub-reach__item">
          <span class="pub-reach__platform">TikTok</span>
          <span class="pub-reach__handle">@musichubwest</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── CRITERIA ─────────────────────────── -->
  <section class="pub-criteria">
    <div class="pub-criteria__inner">
      <p class="pub-eyebrow">PASSAR DITT EVENT?</p>
      <h2 class="pub-section__title">Vad vi publicerar.</h2>
      <p class="pub-criteria__lead">Den här tjänsten är till för dig som är verksam inom musikbranschen i Västra Götaland.</p>

      <h3 class="pub-criteria__group-title">Vi stödjer</h3>
      <ul class="pub-criteria__list">
        <li class="pub-criteria__item">
          <span class="pub-criteria__check">✓</span>
          <span><strong>Event i Västra Götaland.</strong> Vi är regionalt fokuserade.</span>
        </li>
        <li class="pub-criteria__item">
          <span class="pub-criteria__check">✓</span>
          <span><strong>Föreläsningar, workshops, masterclasses, samtal och branschträffar.</strong> Allt som utvecklar musikbranschen.</span>
        </li>
        <li class="pub-criteria__item">
          <span class="pub-criteria__check">✓</span>
          <span><strong>Inkluderande initiativ.</strong> Öppna för ny publik och nya röster i branschen.</span>
        </li>
        <li class="pub-criteria__item">
          <span class="pub-criteria__check">✓</span>
          <span><strong>Event som skickas in minst 3 veckor i förväg.</strong> Vi behöver tid att granska, designa och pusha.</span>
        </li>
      </ul>

      <h3 class="pub-criteria__group-title pub-criteria__group-title--no">Vi prioriterar inte</h3>
      <ul class="pub-criteria__list">
        <li class="pub-criteria__item pub-criteria__item--no">
          <span class="pub-criteria__check pub-criteria__check--no">✕</span>
          <span><strong>Rena konserter eller gigs.</strong> Huben är till för branschutveckling, inte spelningar.</span>
        </li>
        <li class="pub-criteria__item pub-criteria__item--no">
          <span class="pub-criteria__check pub-criteria__check--no">✕</span>
          <span><strong>Rena reklamevent.</strong> Vi värnar om vår community.</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ─── FORMULÄR ────────────────────────── -->
  <section class="pub-form-section" id="formulär">
    <div class="pub-form-section__inner">
      <p class="pub-eyebrow">FORMULÄR</p>
      <h2 class="pub-section__title">Skicka in ditt event.</h2>
      <p class="pub-form-section__lead">Tar 3 minuter. Vi återkommer inom 5 arbetsdagar. Obs — vi publicerar föreläsningar, workshops och branschträffar, men prioriterar inte rena konserter eller gigs.</p>

      <form class="pub-form" id="pub-form" novalidate>
        <!-- Honeypot (hidden from users; bots fill it in) -->
        <div class="pub-form__honeypot" aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="pub-form__row">
          <div class="pub-form__field">
            <label class="pub-form__label" for="firstName">Förnamn <span class="pub-form__req">*</span></label>
            <input class="pub-form__input" type="text" id="firstName" name="firstName" required />
          </div>
          <div class="pub-form__field">
            <label class="pub-form__label" for="lastName">Efternamn <span class="pub-form__req">*</span></label>
            <input class="pub-form__input" type="text" id="lastName" name="lastName" required />
          </div>
        </div>

        <div class="pub-form__row">
          <div class="pub-form__field">
            <label class="pub-form__label" for="email">E-post <span class="pub-form__req">*</span></label>
            <input class="pub-form__input" type="email" id="email" name="email" placeholder="din@epost.se" required />
          </div>
          <div class="pub-form__field">
            <label class="pub-form__label" for="phone">Telefon</label>
            <input class="pub-form__input" type="tel" id="phone" name="phone" placeholder="070-123 45 67" />
          </div>
        </div>

        <div class="pub-form__field">
          <label class="pub-form__label" for="organisation">Organisation / band / företag <span class="pub-form__req">*</span></label>
          <input class="pub-form__input" type="text" id="organisation" name="organisation" required />
        </div>

        <div class="pub-form__field">
          <label class="pub-form__label" for="eventTitle">Eventets titel <span class="pub-form__req">*</span></label>
          <input class="pub-form__input" type="text" id="eventTitle" name="eventTitle" required />
        </div>

        <div class="pub-form__row">
          <div class="pub-form__field">
            <label class="pub-form__label" for="eventDate">Eventets datum <span class="pub-form__req">*</span></label>
            <input class="pub-form__input" type="date" id="eventDate" name="eventDate" required />
          </div>
          <div class="pub-form__field">
            <label class="pub-form__label" for="eventLocation">Plats (venue + stad) <span class="pub-form__req">*</span></label>
            <input class="pub-form__input" type="text" id="eventLocation" name="eventLocation" placeholder="Pustervik, Göteborg" required />
          </div>
        </div>

        <div class="pub-form__field">
          <label class="pub-form__label" for="description">Beskrivning <span class="pub-form__req">*</span></label>
          <textarea class="pub-form__textarea" id="description" name="description" rows="5" maxlength="500" placeholder="Berätta kort vad eventet handlar om, vem som spelar, och varför det är intressant…" required></textarea>
          <span class="pub-form__hint">Max 500 tecken</span>
        </div>

        <div class="pub-form__field">
          <label class="pub-form__label" for="registrationUrl">Länk för anmälan / biljetter</label>
          <input class="pub-form__input" type="url" id="registrationUrl" name="registrationUrl" placeholder="https://…" />
        </div>

        <!-- File upload -->
        <div class="pub-form__field">
          <label class="pub-form__label">Bilder / promo-material</label>
          <label class="pub-form__file-drop" for="files">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="pub-form__file-text">Klicka för att välja filer eller dra hit</span>
            <span class="pub-form__file-hint">JPG, PNG, WEBP eller PDF · max 5 filer · max 10MB per fil</span>
            <input class="pub-form__file-input" type="file" id="files" name="files" accept=".jpg,.jpeg,.png,.webp,.pdf" multiple />
          </label>
          <ul class="pub-form__file-list" id="file-list"></ul>
        </div>

        <!-- Publication channels -->
        <div class="pub-form__field">
          <span class="pub-form__label">Önskad publicering <span class="pub-form__req">*</span></span>
          <div class="pub-form__radios">
            <label class="pub-form__radio">
              <input type="radio" name="publishType" value="site" required />
              <span>Bara på sajten</span>
            </label>
            <label class="pub-form__radio">
              <input type="radio" name="publishType" value="site-and-social" defaultChecked />
              <span>Sajten + sociala kanaler</span>
            </label>
          </div>
        </div>

        <!-- Terms -->
        <fieldset class="pub-form__terms">
          <legend class="pub-form__label">Jag godkänner att <span class="pub-form__req">*</span></legend>
          <label class="pub-form__check">
            <input type="checkbox" name="agree_design" required />
            <span>Music Hub West designar ett nytt omslag som matchar deras brand. Mina originalbilder används som inspiration.</span>
          </label>
          <label class="pub-form__check">
            <input type="checkbox" name="agree_share" required />
            <span>Music Hub West får använda omslag och info om mitt event i sina kanaler (Instagram, LinkedIn, Facebook, TikTok, hemsidan).</span>
          </label>
          <label class="pub-form__check">
            <input type="checkbox" name="agree_credit" required />
            <span>Jag åtar mig att tagga och länka till @musichubwest när jag delar eventet.</span>
          </label>
          <label class="pub-form__check">
            <input type="checkbox" name="agree_actor" required />
            <span>Jag är aktör inom musikbranschen i Västra Götaland.</span>
          </label>
          <label class="pub-form__check">
            <input type="checkbox" name="agree_rights" required />
            <span>Bilderna jag laddar upp får användas av Music Hub West i samband med eventet.</span>
          </label>
        </fieldset>

        <button type="submit" class="btn btn--primary pub-form__submit" id="pub-submit">
          Skicka in event →
        </button>

        <div class="pub-form__error" id="pub-error" hidden>
          Något gick fel. Försök igen eller mejla oss direkt på hello@musichubwest.com.
        </div>
      </form>

      <!-- Success state -->
      <div class="pub-form__success" id="pub-success" hidden>
        <div class="pub-form__success-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
            <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="pub-form__success-title">Tack — vi har tagit emot din ansökan!</h3>
        <p class="pub-form__success-text">
          Vi återkommer inom 5 arbetsdagar med besked. Du har också fått en
          bekräftelse på den e-post du angav.
        </p>
        <a href="/evenemang" class="btn btn--ghost">Tillbaka till alla event →</a>
      </div>
    </div>
  </section>

  <!-- ─── FAQ ──────────────────────────────── -->
  <section class="pub-faq">
    <div class="pub-faq__inner">
      <p class="pub-eyebrow">FAQ</p>
      <h2 class="pub-section__title">Vanliga frågor.</h2>
      <details class="pub-faq__item">
        <summary class="pub-faq__q">Vad om mitt event inte uppfyller alla kriterier?</summary>
        <p class="pub-faq__a">Hör av dig ändå. Vi gör en bedömning från fall till fall — kriterierna är riktlinjer, inte regler.</p>
      </details>
      <details class="pub-faq__item">
        <summary class="pub-faq__q">Kan ni dela mitt event på sociala kanaler innan publicering på sajten?</summary>
        <p class="pub-faq__a">Vi planerar publicering och sociala posts samtidigt. Om du har en tight deadline — skriv det i beskrivningen så försöker vi anpassa.</p>
      </details>
      <details class="pub-faq__item">
        <summary class="pub-faq__q">Vem är tjänsten till för?</summary>
        <p class="pub-faq__a">Den här tjänsten är till för dig som är aktör inom musikbranschen i Västra Götaland. Music Hub West drivs av Tune In West-projektet och finansieras av regionala partners.</p>
      </details>
      <details class="pub-faq__item">
        <summary class="pub-faq__q">Behåller jag rättigheterna till mina bilder?</summary>
        <p class="pub-faq__a">Ja. Du behåller alla rättigheter till originalbilderna. Det nya omslaget som vår designer skapar äger Music Hub West, men det får du också använda fritt för eventet.</p>
      </details>
      <details class="pub-faq__item">
        <summary class="pub-faq__q">Kan jag publicera flera event åt gången?</summary>
        <p class="pub-faq__a">Absolut — skicka in en ansökan per event. Det går snabbt och vi behandlar dem parallellt.</p>
      </details>
    </div>
  </section>

  <Footer lang={lang} />
</Base>

<style>
  /* ─── shared ─────────────────────────── */
  .pub-eyebrow {
    font-family: var(--font);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: var(--lime);
    margin-bottom: 16px;
  }
  .pub-section__title {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--white);
    margin-bottom: 28px;
  }

  /* ─── HERO ───────────────────────────── */
  .pub-hero {
    background: var(--black);
    padding: clamp(64px, 12vw, 140px) var(--px) clamp(56px, 10vw, 100px);
    border-bottom: 1px solid var(--black-3);
  }
  .pub-hero__inner { max-width: var(--max); margin: 0 auto; }
  .pub-hero__title {
    font-family: var(--font-display);
    font-size: clamp(48px, 9vw, 112px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.0;
    color: var(--white);
    margin-bottom: 32px;
  }
  .pub-hero__title-lime { color: var(--lime); }
  .pub-hero__lead {
    font-size: clamp(16px, 1.5vw, 19px);
    color: rgba(255,255,255,0.7);
    line-height: 1.6;
    max-width: 620px;
    margin-bottom: 40px;
  }
  .pub-hero__ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .btn--ghost {
    background: transparent;
    border: 1px solid var(--black-3);
    color: var(--white);
    transition: border-color 0.15s, background 0.15s;
  }
  .btn--ghost:hover { border-color: var(--lime); background: rgba(204,255,0,0.04); }

  /* ─── VALUE PROPS ────────────────────── */
  .pub-value { padding: clamp(64px, 10vw, 120px) var(--px); border-bottom: 1px solid var(--black-3); }
  .pub-value__inner { max-width: var(--max); margin: 0 auto; }
  .pub-value__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-top: 40px;
  }
  .pub-value__item {
    background: var(--black-2);
    border: 1px solid var(--black-3);
    border-radius: 8px;
    padding: 32px 28px;
    transition: border-color 0.2s, background 0.2s;
  }
  .pub-value__item:hover { border-color: var(--lime); background: rgba(204,255,0,0.03); }
  .pub-value__num {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    color: var(--lime);
    margin-bottom: 16px;
  }
  .pub-value__heading {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--white);
    margin-bottom: 10px;
  }
  .pub-value__text {
    font-size: 14px;
    color: rgba(255,255,255,0.65);
    line-height: 1.6;
  }

  /* ─── PROCESS ────────────────────────── */
  .pub-process {
    background: var(--black-2);
    padding: clamp(64px, 10vw, 120px) var(--px);
    border-bottom: 1px solid var(--black-3);
  }
  .pub-process__inner { max-width: var(--max); margin: 0 auto; }
  .pub-process__steps {
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }
  .pub-process__step {
    display: flex;
    gap: 20px;
    padding: 24px;
    background: var(--black);
    border: 1px solid var(--black-3);
    border-radius: 8px;
  }
  .pub-process__step-num {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    color: var(--lime);
    line-height: 1;
    flex-shrink: 0;
  }
  .pub-process__step-title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--white);
    margin-bottom: 8px;
  }
  .pub-process__step-text {
    font-size: 14px;
    color: rgba(255,255,255,0.65);
    line-height: 1.6;
  }

  /* ─── ABOUT / PARTNERS ──────────────── */
  .pub-about { padding: clamp(64px, 10vw, 120px) var(--px); border-bottom: 1px solid var(--black-3); }
  .pub-about__inner { max-width: var(--max); margin: 0 auto; }
  .pub-about__text {
    font-size: 17px;
    color: rgba(255,255,255,0.75);
    line-height: 1.7;
    max-width: 720px;
    margin-bottom: 28px;
  }
  .pub-about__partners {
    display: flex;
