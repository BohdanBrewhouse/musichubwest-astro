---
export interface Props {
  title: string;
  date: string;
  time: string;
  category: string;
  image: string;
  slug: string;
  lang: 'sv' | 'en';
  past?: boolean;
  organizer?: string;
  isOwn?: boolean;
  eventType?: string;
  eventLanguage?: string;
}
const { title, date, time, category, image, slug, lang, past = false, organizer, isOwn = false, eventType = 'Event', eventLanguage } = Astro.props;
const eventsBase = lang === 'en' ? '/en/events' : '/evenemang';

function formatDate(d: string, l: 'sv' | 'en') {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(d)) return d;
  return new Intl.DateTimeFormat(l === 'sv' ? 'sv-SE' : 'en-US', {
    day: 'numeric', month: 'long', year: 'numeric'
  }).format(new Date(d + 'T12:00:00'));
}
const displayDate = formatDate(date, lang);

const isUtlysning  = eventType === 'Utlysning';
const arrangerLabel  = lang === 'en' ? 'Organiser' : 'Arrangör';
const mhwChipText    = lang === 'en' ? 'MHW Organiser' : 'MHW Arrangör';
const arrangerName   = isOwn ? 'Music Hub West' : (organizer ?? '');

// Date/time display: Utlysning shows deadline label first, regular shows date · time
const datetimeText = isUtlysning
  ? `${time} · ${displayDate}`
  : `${displayDate}${time ? ` · ${time}` : ''}`;

// Language chip: show when event is in a different language than the page
function getLangChip(evLang: string | undefined, pgLang: 'sv' | 'en'): string | null {
  if (!evLang) return null;
  const norm = evLang.toLowerCase();
  if (pgLang === 'sv') {
    if (norm === 'engelska' || norm === 'english') return 'Engelska';
    if (norm === 'tvåspråkigt' || norm === 'bilingual') return 'Tvåspråkigt';
    return null;
  } else {
    if (norm === 'svenska' || norm === 'swedish') return 'Swedish';
    if (norm === 'tvåspråkigt' || norm === 'bilingual') return 'Bilingual';
    return null;
  }
}
const langChip = getLangChip(eventLanguage, lang);

const badgeClass: Record<string, string> = {
  'Tune In West':              'badge--tiw',
  'Kulturverkstaden':          'badge--kv',
  'Högskolan för scen och musik': 'badge--hsm',
  'VGR':                       'badge--vgr',
  'Externa event':             'badge--externa',
  'External events':           'badge--externa',
  'Kulturakademin':            'badge--kulturakademin',
};
---
<a href={`${eventsBase}/${slug}`} class={`event-card${past ? ' event-card--past' : ''}${isOwn ? ' event-card--own' : ''}`} data-category={category}>
  <div class="event-card__image">
    <img src={image} alt={title} loading="lazy" />
    <span class={`badge ${badgeClass[category] ?? ''} event-card__badge`}>{category}</span>
    {isOwn && (
      <span class="event-card__mhw-chip">{mhwChipText}</span>
    )}
    {isUtlysning && (
      <span class="event-card__utlysning-chip">{lang === 'en' ? 'Open call' : 'Utlysning'}</span>
    )}
  </div>
  <div class="event-card__body">
    <p class="event-card__datetime">{datetimeText}</p>
    <h3 class="event-card__title">{title}</h3>
    {langChip && (
      <span class="event-card__lang-chip">{langChip}</span>
    )}
    {arrangerName && (
      <p class="event-card__arranger">{arrangerLabel} · {arrangerName}</p>
    )}
  </div>
</a>

<style>
  /* ── Own event: lime left border ── */
  .event-card--own {
    border-left: 3px solid var(--lime);
    padding-left: 12px;
    margin-left: -15px;
  }

  /* ── MHW chip overlay (top-right of image) ── */
  .event-card__mhw-chip {
    position: absolute;
    top: 10px;
    right: 10px;
    background: var(--lime);
    color: var(--black);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 4px;
    line-height: 1;
    pointer-events: none;
  }

  /* ── Utlysning chip (bottom-left of image) ── */
  .event-card__utlysning-chip {
    position: absolute;
    bottom: 10px;
    left: 10px;
    background: #F59E0B;
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 4px;
    line-height: 1;
    pointer-events: none;
    z-index: 2;
  }

  /* ── Language indicator chip (in body) ── */
  .event-card__lang-chip {
    display: inline-block;
    margin-top: 6px;
    margin-bottom: 4px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.55);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 4px;
    line-height: 1;
  }

  /* ── Arranger line ── */
  .event-card__arranger {
    font-size: 12px;
    font-weight: 600;
    color: rgba(255,255,255,0.4);
    margin-top: 6px;
    letter-spacing: 0.01em;
  }
  .event-card--own .event-card__arranger {
    color: rgba(200,242,62,0.6);
  }
</style>
