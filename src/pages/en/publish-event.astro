    gap: 24px;
  }
  .pub-form__honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .pub-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .pub-form__field { display: flex; flex-direction: column; gap: 8px; }
  .pub-form__label { font-size: 13px; font-weight: 600; color: rgba(255,255,255,0.85); }
  .pub-form__req { color: var(--lime); margin-left: 2px; }
  .pub-form__input,
  .pub-form__textarea {
    font-family: var(--font);
    font-size: 15px;
    color: var(--white);
    background: var(--black-2);
    border: 1px solid var(--black-3);
    border-radius: 6px;
    padding: 12px 14px;
    transition: border-color 0.15s, box-shadow 0.15s;
    width: 100%;
    box-sizing: border-box;
  }
  .pub-form__textarea { resize: vertical; min-height: 110px; }
  .pub-form__input:focus,
  .pub-form__textarea:focus {
    outline: none;
    border-color: var(--lime);
    box-shadow: 0 0 0 3px rgba(204,255,0,0.12);
  }
  .pub-form__hint { font-size: 12px; color: rgba(255,255,255,0.4); }

  .pub-form__file-drop {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 28px 20px;
    background: var(--black-2);
    border: 2px dashed var(--black-3);
    border-radius: 8px;
    cursor: pointer;
    color: rgba(255,255,255,0.6);
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }
  .pub-form__file-drop:hover { border-color: var(--lime); color: var(--white); background: rgba(204,255,0,0.04); }
  .pub-form__file-text { font-size: 14px; font-weight: 600; }
  .pub-form__file-hint { font-size: 12px; color: rgba(255,255,255,0.4); }
  .pub-form__file-input { display: none; }
  .pub-form__file-list { list-style: none; padding: 0; margin: 8px 0 0; display: flex; flex-direction: column; gap: 6px; }
  .pub-form__file-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background: var(--black-2);
    border: 1px solid var(--black-3);
